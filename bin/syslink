# Enable Strict Mode
set -u

. "/etc/sysconfig.conf" 2> /dev/null
if [ -z "$SYSCONFIG" ]; then
    echo "Error: system configuration directory not found!"
    exit 1
fi
if ! [ -d "$SYSCONFIG" ]; then
    printf 'Error: system configuration directory "%s" does not exist!\n' "$SYSCONFIG"
    exit 1
fi

SYSCONFIG=${SYSCONFIG%/}

if ! [ "$USER" = "root" ]; then
    echo "Error: root is required!"
    exit 1
fi

relink "$SYSCONFIG" /

pacman -Qeqn 1> "${SYSCONFIG}/packages.save"
pacman -Qqm | grep -vE '^smd$|^(smd|dij)-([a-zA-Z-])$' 1> "${SYSCONFIG}/packages-aur.save"
systemctl list-unit-files --plain --full --no-pager --legend=false | grep "masked" | awk '{print $1}' 1> "${SYSCONFIG}/masked.save"
systemctl list-unit-files --plain --full --no-pager --legend=false | awk '{print $1" "$2}' | grep "enabled" | grep -vE ".target|enabled-runtime|@" | awk '{print $1}' 1> "${SYSCONFIG}/units.save"
systemctl list-units --plain --full --no-pager --legend=false | grep "@." | grep -vE "dead|exited|etc-pacman\.d-gnupg\.service" | awk '{print $1}' | grep -vE "getty|user|blockdev" | grep "@." 1> "${SYSCONFIG}/indirect.save"

if [ -d "/etc/syscheck.d" ]; then
    for entry in /etc/syscheck.d/*.sh; do
        if [ -f "$entry" ]; then
            printf 'Processing script "%s"..\n' "$entry"
            . "$entry"
        fi
    done
fi

sync
echo "Broken Links Found:"
find / -xdev -not -path '/proc/*' -not -path '/tmp/*' -not -path '/run/*' -xtype l 2> /dev/null | grep -vE "/proc|/tmp|/run"
echo "Done!"
exit 0
