set -u

if [ $# -ne 2 ]; then
    echo "linkcheck <link> <target>"
    exit 1
fi

target="$(readlink "$1" 2> /dev/null)"
if [ $? -eq 0 ] && [ "$target" = "$2" ]; then
    if [ "$USER" = "root" ]; then
        chown root:root "$1"
    fi
    exit 0
fi

rm -f "$1" 2> /dev/null
if ! ln -sT "$2" "$1"; then
    printf 'Creating link "%s" to "%s" failed!\n' "$1" "$2"
    exit 1
fi

if [ "$USER" = "root" ]; then
    chown root:root "$1"
fi

printf 'Link "%s" to "%s" created.\n' "$1" "$2"
