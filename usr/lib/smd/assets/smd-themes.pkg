pkgrel=1
pkgver=1.2.0
pkgname="smd-user-themes"
pkgdesc="System Management Daemon theme base packages"

url="https://github.com/iDigitalFlame/spaceport"
arch=( "any" )
license=( "GPL-3.0" )

source=()
noextract=()
sha256sums=()

depends=(
    ## Fonts
    "noto-fonts-emoji"
    "otf-fira-mono"
    "otf-font-awesome-4"
    "ttf-hack-nerd"
    "ttf-roboto"

    ## Themes
    "flatery-icon-theme-git"
    "kora-icon-theme"
    "vimix-cursors"
)
