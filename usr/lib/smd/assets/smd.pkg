pkgrel=1
pkgver=1.5.1
pkgname="smd"
pkgdesc="System Management Daemon base packages"

url="https://github.com/iDigitalFlame/spaceport"
arch=( "any" )
license=( "GPL-3.0" )

source=()
noextract=()
sha256sums=()

depends=(
    ## Base
    "dash"
    "fakeroot"
    "logrotate"
    "mkinitcpio"
    "pacman-contrib"
    "polkit"
    "python"
    "python-gobject"
    "reflector"
    "systemd"

    ## Backup
    "openssh"
    "rsync"
    "tar"
    "zstd"

    ## Hydra
    "dhcpcd"
    "dnsmasq"
    "edk2-ovmf"
    "iproute2"
    "qemu-audio-alsa"
    "qemu-audio-pa"
    "qemu-audio-spice"
    "qemu-base"
    "qemu-chardev-spice"
    "qemu-hw-display-qxl"
    "qemu-hw-display-virtio-gpu"
    "qemu-hw-display-virtio-gpu-pci"
    "qemu-hw-display-virtio-vga"
    "qemu-hw-usb-host"
    "qemu-hw-usb-redirect"
    "qemu-vhost-user-gpu"
    "samba"
    "spice"
    "swtpm"

    ## Security / Hardening
    "apparmor"
    "iptables-nft"
    "python-notify2" # aa-notify
    "python-psutil"  # aa-notify
    "tk" # aa-notify

    ## Secure Boot
    "efitools"
    "openssl"
    "sbsigntools"

    ## Wireless / Bluetooth
    "bluez"
    "bluez-utils"    # bluetoothctl
    "util-linux"
    "wireless-regdb"

    ## Audio / Video
    "pipewire-alsa"
    "pipewire-pulse"
    "pipewire-v4l2"
    "wireplumber"

    ## File System Utilities
    "btrfs-progs"
    "lvm2"
    "xfsprogs"

    ## Networking
    "networkmanager"

    ## Authentication
    "pam-u2f" # YubiKey Login / Unlock

    ## Additional Firmware for Wireless Devices
    "linux-firmware-atheros"
    "linux-firmware-broadcom"
    "linux-firmware-mediatek"
    "linux-firmware-realtek"
)
