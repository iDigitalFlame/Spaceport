pkgrel=1
pkgver=1.2.0
pkgname="smd-user"
pkgdesc="System Management Daemon base userspace and client packages"

url="https://github.com/iDigitalFlame/spaceport"
arch=( "any" )
license=( "GPL-3.0" )

source=()
noextract=()
sha256sums=()

depends=(
    ## Wayland
    "qt5-wayland"
    "qt6-wayland"
    "swayfx"                 # "sway"
    "swaybg"
    "swayidle"
    "swaync"
    "wl-clipboard"
    "xorg-xwayland"
    "xdg-desktop-portal-wlr"
    "xdg-utils"

    ## Screenshots / Clipping
    "grim"
    "slurp"

    ## Hydra
    "spice-gtk"
    "tigervnc"

    ## Lockscreen
    "gtklock"
    "imagemagick"

    ## Networking
    "network-manager-applet"

    ## Keyring
    "gnome-keyring"
    "libsecret"

    ## Navigation / UI
    "rofi-wayland"
    "waybar"
)
