# smd-daemon
#   Entrypoint for the SMD server daemon.
#
# Usage:
#   smd-daemon [-s socket_file] [-l log_file] [-n log_level] [-c config_file] [-r]
#
#   Starts the system management daemon. Recommended only to be used by systemd as
#   root.
#
# Exit Codes:
#   0 - Completed successfully
#   1 - Error occurred or syntax error

import sys

sys.path.insert(0, "/usr/lib/smd")

from os import getuid
from sys import exit, stderr
from lib import Server, print_error
from argparse import ArgumentParser
from lib.constants import LOG_LEVELS, VERSION
from lib.constants.config import LOG_PATH_SERVER, LOG_LEVEL, SOCKET, CONFIG_SERVER


HELP_TEXT = """System Management Daemon (v{version})

System-level service process for the System Management Daemon. This must be only
run under a SystemD service as the root user.

Usage:
  smd-daemon [-s socket] [-l log] [-n log_level] [-c config] [-j] [-r]

Command Line Options:
  -s           <socket>    Path to the SMD control socket to listen on.
  --socket                  Defaults to "{socket}".
  -l           <log_file>  Path to the log output file. Defaults to
  --log                     "{log}".
  -n           <log_level> The log level to use. (The values [0-4] or DEBUG,
  --log-level               INFO, WARNING, ERROR or CRITICAL). Defaults to "{level}".
  -c           <config>    Path to the SMD Daemon configuration file. Defaults
  --config                  to "{config}".
  -j                       Omit the status values "time" and "name" in console
  --journal                 output. Prevents duplication of these values when
                            running as a SystemD service.
  -r                       Do not write to the configuration file.
  --read-only
"""


def _help(*_):
    print(
        HELP_TEXT.format(
            socket=SOCKET,
            version=VERSION,
            log=LOG_PATH_SERVER,
            config=CONFIG_SERVER,
            level=f"{LOG_LEVEL}".upper(),
        ),
        file=stderr,
    )
    exit(2)


def _main(args):
    if getuid() != 0:
        return print_error("Cannot run the daemon as a non-root user!")
    try:
        s = Server(
            args.config,
            args.socket,
            args.log_level,
            args.log_file,
            args.read_only,
            args.journal,
        )
    except Exception as err:
        return print_error("Cannot create the Server instance!", err)
    try:
        if not s.start():
            return print_error("Server encountered an error, quitting!", quit=False)
    except KeyboardInterrupt:
        pass
    except Exception as err:
        return print_error("Error during runtime!", err, False)
    finally:
        s.stop()
        del s
    return True


if __name__ == "__main__":
    p = ArgumentParser(description="System Management Daemon Server")
    p.add_argument(
        "-s",
        "--socket",
        type=str,
        dest="socket",
        help="socket to use for messages",
        action="store",
        metavar="socket",
        default=SOCKET,
        required=False,
    )
    p.add_argument(
        "-l",
        "--log",
        type=str,
        dest="log_file",
        help="log file to output to",
        action="store",
        metavar="log_file",
        default=LOG_PATH_SERVER,
        required=False,
    )
    p.add_argument(
        "-n",
        "--log-level",
        type=str,
        dest="log_level",
        help="log level for logging",
        action="store",
        metavar="log_level",
        default=LOG_LEVEL.lower(),
        choices=LOG_LEVELS.keys(),
        required=False,
    )
    p.add_argument(
        "-c",
        "--config",
        type=str,
        dest="config",
        help="path to the client configuration file",
        action="store",
        metavar="config",
        default=CONFIG_SERVER,
        required=False,
    )
    p.add_argument(
        "-j",
        "--journal",
        dest="journal",
        help="format stdout log for journal/syslog",
        action="store_true",
    )
    p.add_argument(
        "-r",
        "--read-only",
        dest="read_only",
        help="do not write to config files",
        action="store_true",
    )
    p.print_help = _help
    if not _main(p.parse_args()):
        exit(1)
    exit(0)
