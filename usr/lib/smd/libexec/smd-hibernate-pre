# smd-hibernate-pre
#   Script used by Systemd before the system hibernates to inform SMD to start the
#   pre-hibernate process. Can only be called by Systemd.

export PYTHONOPTIMIZE=2
export PYTHONPYCACHEPREFIX="/var/cache/python"

exec /usr/lib/smd/libexec/smd-message --root --translate hibernate --wait ok --timeout 5 --exit 0 --payload '{"type": 0}' 1> /dev/null
