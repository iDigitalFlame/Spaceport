[Unit]
After                   = network.target
After                   = smd-daemon.service
Requires                = network.target
Requires                = smd-daemon.service
Description             = System Management Daemon Hydra SMB Support

[Service]
Type                    = notify
PIDFile                 = /run/hydra/smbd.pid
ExecStart               = /usr/bin/smbd --foreground --no-process-group --configfile=/var/run/smd/hydra/smb.conf
ExecReload              = /usr/bin/kill -HUP $MAINPID
PrivateTmp              = true
KeyringMode             = private
PrivatePIDs             = true
PrivateUsers            = false
ProtectClock            = false
ProtectSystem           = full
PrivateDevices          = false
ReadWritePaths          = /home
LockPersonality         = true
NoNewPrivileges         = false
ProtectHostname         = true
RestrictRealtime        = true
RestrictSUIDSGID        = true
SystemCallFilter        = ~@debug
SystemCallFilter        = ~@obsolete
ProtectKernelLogs       = true
RestrictNamespaces      = true
ProtectControlGroups    = true
ProtectKernelModules    = true
CapabilityBoundingSet   = ~CAP_BPF
CapabilityBoundingSet   = ~CAP_LEASE
CapabilityBoundingSet   = ~CAP_SYSLOG
CapabilityBoundingSet   = ~CAP_PERFMON
CapabilityBoundingSet   = ~CAP_SYS_BOOT
CapabilityBoundingSet   = ~CAP_SYS_TIME
CapabilityBoundingSet   = ~CAP_IPC_OWNER
CapabilityBoundingSet   = ~CAP_SYS_PACCT
CapabilityBoundingSet   = ~CAP_MAC_ADMIN
CapabilityBoundingSet   = ~CAP_SYS_PTRACE
CapabilityBoundingSet   = ~CAP_SYS_MODULE
CapabilityBoundingSet   = ~CAP_AUDIT_READ
CapabilityBoundingSet   = ~CAP_WAKE_ALARM
CapabilityBoundingSet   = ~CAP_AUDIT_WRITE
CapabilityBoundingSet   = ~CAP_SYS_RESOURCE
CapabilityBoundingSet   = ~CAP_MAC_OVERRIDE
CapabilityBoundingSet   = ~CAP_AUDIT_CONTROL
CapabilityBoundingSet   = ~CAP_BLOCK_SUSPEND
CapabilityBoundingSet   = ~CAP_SYS_TTY_CONFIG
CapabilityBoundingSet   = ~CAP_LINUX_IMMUTABLE
CapabilityBoundingSet   = ~CAP_CHECKPOINT_RESTORE
ProtectKernelTunables   = false
MemoryDenyWriteExecute  = true
RestrictAddressFamilies = AF_INET AF_NETLINK AF_UNIX
