include <tunables/spaceport>

profile xkbcomp /usr/bin/xkbcomp flags=(enforce, attach_disconnected) {
    include <abstractions/X>
    include <abstractions/base>
    include <abstractions/mesa>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/private-files>

    /usr/bin/xkbcomp                          rm,
    /usr/share/X11/xkb/**                     r,

    /dev/fb*                                  rw,
    /dev/dri/card*                            rw,
    /dev/dri/render*                          rw,
    /dev/input/event*                         rw,

    owner @{run}/user/@{uid}/server-*.xkm     rwk,

    owner /tmp/server-*.xkm                   rwk,

    unix (receive, send) type=stream addr=none peer=(label=xwayland),

    deny /var/log/Xorg.*.log                  rw,
    deny @{HOME}/.xsession-errors{,.*}        rw,
    deny @{HOME}/.local/share/xorg/Xorg.*.log rw,

    include if exists <local/usr.bin.xkbcomp>
}
