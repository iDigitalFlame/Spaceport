include <tunables/spaceport>

profile xfconfd /usr/lib/xfce4/xfconf/xfconfd flags=(enforce) {
    include <abstractions/gui>
    include <abstractions/no-network>
    include <abstractions/xdg-desktop>
    include <abstractions/private-files>
    include <abstractions/freedesktop.org>

    /usr/share/xfce{,4}/                            r,
    /etc/xdg/xfce4/xfconf/**                        r,
    /usr/lib/xfce4/xfconf/xfconfd                   rm,

    owner @{HOME}/                                  r,
    owner @{HOME}/.config/xfce4/xfconf/**           r,

    owner @{CONFIG}/xfce4/xfconf/**/*.xml           r,

    owner @{HOME}/.config/xfce4/                    rw,
    owner @{HOME}/.config/xfce4/help{,ers}.rc       rw,
    owner @{HOME}/.config/xfce4/help{,ers}.rc.*.tmp rw,

    deny @{CONFIG}/xfce4/xfconf/**/*.xml{,.new}     w,

    include if exists <local/usr.lib.xfconfd>
}
