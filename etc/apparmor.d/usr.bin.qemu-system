include <tunables/spaceport>

profile qemu-system /usr/bin/qemu-system-* flags=(enforce, attach_disconnected) {
    include <abstractions/dri>
    include <abstractions/base>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/video>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/dri-common>
    include <abstractions/no-network>
    include <abstractions/nameservice>
    include <abstractions/nss-systemd>

    capability                                                             setgid,
    capability                                                             setuid,
    capability                                                             perfmon,
    capability                                                             ipc_lock,
    capability                                                             net_admin,
    capability                                                             sys_admin,
    capability                                                             dac_override,
    capability                                                             dac_read_search,

    /etc/libnl/*                                                           r,
    /etc/machine-id                                                        r,
    /usr/share/qemu/**                                                     r,
    /etc/sasl2/qemu.conf                                                   r,
    /usr/share/edk2/**/*.{fd,img,raw}                                      rk,

    /dev/                                                                  r,
    /dev/shm/                                                              r,
    /dev/bus/{,usb/}                                                       r,

    /sys/bus/usb/                                                          r,
    /sys/class/tty/                                                        r,
    /sys/{bu,clas}s/                                                       r,
    /sys/class/usbmisc/                                                    r,
    /sys/devices/system/node/                                              r,
    /sys/bus/usb/devices/{,**}                                             r,
    /sys/devices/**/usb*/**/{idVendor,idProduct}                           r,
    /sys/module/vhost/parameters/max_mem_regions                           r,
    /sys/devices/**/usb*/**/{manufacturer,serial,product}                  r,

    /proc/1/cmdline                                                        r,
    /proc/sys/vm/max_map_count                                             r,
    /proc/sys/kernel/random/boot_id                                        r,

    @{run}/udev/data/c1*:*                                                 r,
    @{run}/udev/data/+usb:*                                                r,
    @{run}/smd/hydra/*.bios                                                r,

    /opt/hydra/*/**/*.{disk,fd,img,raw,qcow,qcow2,vdmk}                    rwk,

    /dev/kvm                                                               rw,
    /dev/net/tun                                                           rw,
    /dev/vhost-net                                                         rw,
    /dev/bus/usb/**                                                        rw,
    /dev/dri/renderD128                                                    rw,
    /dev/hugepages/*.ram                                                   rwk,

    @{run}/smd/hydra/*.swtpm                                               rw,
    @{run}/smd/hydra/*.{pid,qga,spice,sock,vnc}                            rwk,

    owner /proc/@{pid}/task/@{tid}/comm                                    rw,

    owner /var/cache/root/                                                 r,
    owner /var/cache/root/mesa_shader_cache/                               rw,
    owner /var/cache/root/mesa_shader_cache/index                          rw,
    owner /var/cache/root/mesa_shader_cache/[a-f0-9][a-f0-9]/              rw,
    owner /var/cache/root/mesa_shader_cache/[a-f0-9][a-f0-9]/[0-9a-f]*     rw,
    owner /var/cache/root/mesa_shader_cache/[a-f0-9][a-f0-9]/[0-9a-f]*.tmp rwk,

    owner /var/cache/root/mesa_shader_cache_db/                            rw,
    owner /var/cache/root/mesa_shader_cache_db/{index,marker,part*/}       rwk,
    owner /var/cache/root/mesa_shader_cache_db/part*/mesa_cache.{db,idx}   rwk,

    # Read CDs and ISOs
    /**/*.{bin,cd,disk,img,iso}                                            rk,
    /opt/hydra/*/**/*.{bin,cd,disk,img,iso}                                rk,

    # Prevent QEMU from executing applications
    deny /**                                                               x,

    include if exists <local/usr.bin.qemu-system>
}
