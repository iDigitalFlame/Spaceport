include <tunables/spaceport>

profile vesktop /usr/bin/vesktop flags=(enforce) {
    include <abstractions/video>
    include <abstractions/chromium>
    include <abstractions/user-home>
    include <abstractions/notifications>
    include <abstractions/dbus-network-manager-strict>

    ptrace read  peer=vesktop,
    ptrace read  peer=electron,
    ptrace read  peer=/usr/bin/xdg-{open,settions,email},
    ptrace read  peer=/usr/{bin/electron*,lib/electron*/electron},
    ptrace trace peer=vesktop,
    ptrace trace peer=electron,
    ptrace trace peer=/usr/lib/electron*/chrome-sandbox,
    ptrace trace peer=/usr/{bin/electron*,lib/electron*/electron},

    /usr/bin/bash                               r,
    /usr/bin/vesktop                            r,
    /usr/lib/vesktop/{,**}                      r,

    /sys/{bus,class}/                           r,
    /sys/bus/pci/devices                        r,
    /sys/devices/virtual/dmi/id/bios_vendor     r,

    owner @{CONFIG}/vesktop/themes/*.css        r,

    owner @{HOME}/.config/vesktop/{,**}         rwk,

    /usr/bin/slurp                              ix,
    /usr/bin/xdg-open                           Pix -> xdg-open,
    /usr/bin/electron*                          ixr,
    /usr/bin/xdg-email                          Pix -> xdg-email,
    # /usr/bin/xdg-settings                       Pix -> xdg-settings,
    /usr/lib/electron*/chrome-sandbox           ix,
    /usr/{bin/electron*,lib/electron*/electron} ixr,

    deny ptrace read  peer=unconfined,
    deny ptrace trace peer=unconfined,

    # NOTE(dij): Stop the "no new privs" errors in electron.
    deny /sys/class/*/                          r,
    deny /sys/bus/*/devices/                    r,
    deny /usr/bin/xdg-settings                  x,

    include if exists <local/usr.lib.vesktop>
}
