include <tunables/spaceport>

profile tumblerd /usr/lib/tumbler{,-1}/tumblerd flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/mime>
    include <abstractions/fonts>
    include <abstractions/glycin>
    include <abstractions/no-network>
    include <abstractions/glycin-base>
    include <abstractions/nameservice>
    include <abstractions/user-data-ro>

    /**/*.@{IMAGES}                                                                 r,

    /var/tmp/                                                                       r,
    /etc/fstab                                                                      r,
    /etc/xdg/tumbler/*                                                              r,
    /etc/ImageMagick-*/*.xml                                                        r,
    /usr/lib/libvisual-*/*/*.so                                                     rm,
    /usr/lib/tumbler-1/tumblerd                                                     rm,
    /usr/share/thumbnailers/{,**}                                                   r,
    /usr/share/ImageMagick-*/*.xml                                                  r,
    /usr/lib/libproxy/*/modules/*.so                                                rm,
    /usr/share/backgrounds/xfce/{,**}                                               r,
    /usr/share/gstreamer-1.0/presets/Gst*Enc.prs                                    r,

    /dev/                                                                           r,
    /dev/dri/                                                                       r,
    /dev/bus/usb/                                                                   r,

    /sys/class/drm/                                                                 r,
    /sys/{bu,clas}s/                                                                r,
    /sys/bus/usb/devices/                                                           r,
    /sys/bus/media/devices/                                                         r,
    /sys/class/video4linux/                                                         r,
    /sys/devices/system/node/                                                       r,
    /sys/devices/pci*/**/descriptors                                                r,
    /sys/devices/pci*/**/{bus,dev}num                                               r,
    /sys/devices/system/node/node*/meminfo                                          r,
    /sys/devices/pci*/**/{config,speed,uevent}                                      r,

    @{run}/udev/data/c*:*                                                           r,
    @{run}/udev/data/+usb:*                                                         r,
    @{run}/udev/data/+drm:card*-*                                                   r,

    /tmp/                                                                           r,

    owner /proc/@{pid}/mountinfo                                                    r,

    owner /tmp/tumbler-*                                                            rw,
    owner /tmp/gsf-thumbnailer-*                                                    rw,

    owner @{CACHE}/thumbnails/                                                      rw,
    owner @{CACHE}/gstreamer-*/                                                     rw,
    owner @{CACHE}/thumbnails/{l,n,x}*/*.png{,.*}                                   rw,
    owner @{CACHE}/gstreamer-*/registry.*.bin{,.tmp*}                               rw,
    owner @{CACHE}/thumbnails/{fail,*large,normal}/#*                               rw,
    owner @{CACHE}/thumbnails/{l,n,x}*/{,#*,.goutputstream-*}                       rw,
    owner @{CACHE}/thumbnails/{fail,*large,normal}/gnome-thumbnail-factory/{,*.png} rw,

    /usr/bin/magick                                                                 ix,
    /usr/bin/*{,-}thumbnailer                                                       ix,
    /usr/lib/glycin-loaders/2+/glycin-*                                             ix,
    /usr/lib/{,gstreamer1.0}gstreamer1.0/gstreamer-1.0/gst-plugin-scanner           ix,

    deny /systemd/journal/stdout                                                    rw,

    include if exists <local/usr.lib.tumblerd>
}
