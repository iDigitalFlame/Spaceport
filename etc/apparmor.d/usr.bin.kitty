include <tunables/spaceport>

profile kitty /usr/bin/kitty flags=(enforce) {
    include <abstractions/dri>
    include <abstractions/gui>
    include <abstractions/mesa>
    include <abstractions/python>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/private-files>

    capability                         sys_ptrace,

    signal send set=(hup, int, kill, quit, term),

    ptrace read  peer=kitty,
    ptrace trace peer=kitty,

    /usr/bin/kitty                     rm,

    /proc/                             r,

    owner /proc/@{pid}/stat            r,
    owner /proc/@{pid}/cgroup          r,
    owner /proc/@{pid}/mount{info,s}   r,

    owner @{run}/user/@{uid}/          r,

    owner @{CONFIG}/kitty{,/}          r,
    owner @{CONFIG}/kitty/kitty.conf   r,

    /dev/ptmx                          rw,

    owner @{HOME}/.cache/kitty{,/,/**} rw,

    /usr/bin/kitten                    ix,
    /usr/bin/xdg-open                  Px -> xdg-open,
    /usr/bin/{ba,da,z}sh               Px -> shell,

    deny ptrace read,

    include if exists <local/usr.bin.kitty>
}
