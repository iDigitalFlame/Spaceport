include <tunables/spaceport>

profile ghr /{opt/spaceport,usr}/bin/ghr flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                  setgid,
    capability                                  setuid,
    capability                                  dac_override,
    capability                                  dac_read_search,

    # NOTE(dij): We can't scrub these as this can cause the apps to fail to load
    #            any non-standard libraries.
    /usr/bin/**                                 pux,
    /opt/notesnook/**                           pux,
    /usr/lib{,32,64}/**                         puxm,
    /opt/vscodium-bin/**                        pux,
    /opt/ultimaker-cura/**                      pux,
    /{usr,opt/spaceport}/bin/**                 pux,

    # NOTE(dij): GHR is SUID so it's not an owner.
    @{HOME}/.config/rust/**                     PUx,
    @{HOME}/.local/lib/go/bin/**                PUx,
    @{HOME}/Documents/Utilities/**              PUx,
    @{HOME}/.private/.local/bin/**              PUx,
    @{HOME}/.dotfiles/.local/bin/**             PUx,
    @{HOME}/.local/{apps,bin,lib}/**            PUx,
    @{HOME}/.vscode-oss/extensions/**           PUx,
    @{HOME}/.config/VSCodium/Home/extensions/** PUx,

    deny network,

    deny /dev/dri/**                           rw,
    deny @{CACHE_TMP}/mesa{,_db}/**            rw,
    deny @{CACHE}/mesa_shader_cache{,_db}/**   rw,

    # Disconnected path
    deny /apparmor/.null                       rw,

    include if exists <local/usr.bin.ghr>
}
