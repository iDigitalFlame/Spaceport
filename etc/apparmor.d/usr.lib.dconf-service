include <tunables/spaceport>

profile dconf-service /usr/lib/dconf-service flags=(attach_disconnected, enforce) {
    include <abstractions/base>
    include <abstractions/dconf>
    include <abstractions/no-network>
    include <abstractions/private-files>

    signal receive set=(hup, kill, term) peer=dbus-session,

    /etc/machine-id                                 r,
    /usr/lib/dconf-service                          rm,
    /var/lib/dbus/machine-id                        r,

    /proc/cmdline                                   r,

    owner @{run}/user/@{uid}/bus                    rw,

    owner /tmp/dbus-*                               rw,

    owner @{CACHE}/dconf/{,user,user.*}             rw,

    owner @{HOME}/.config/dconf/{,user,user.*}      rw,
    owner @{HOME}/.config/glib-2.0/settings/keyfile w,

    unix (bind, listen) type=stream addr="@/tmp/dbus-*",

    unix (accept, connect, receive, send) type=stream addr="@/tmp/dbus-*",
    unix (accept, connect, receive, send) type=stream peer=(addr="@/tmp/dbus-*"),

    dbus (receive, send) bus=session interface=ca.desrt.dconf,

    dbus receive bus=session interface=org.freedesktop.DBus.Introspectable member=Introspect peer=(name=:*, label=gnome-shell),

    dbus send bus=session path=/org/freedesktop/DBus interface=org.freedesktop.DBus member={RequestName,ReleaseName} peer=(name=org.freedesktop.DBus, label=dbus-session),
    dbus send bus=session path=/org/freedesktop/DBus interface=org.freedesktop.DBus member={Hello,AddMatch,RemoveMatch,GetNameOwner,NameHasOwner,StartServiceByName} peer=(name=org.freedesktop.DBus, label=dbus-session),

    include if exists <local/usr.lib.dconf-service>
}
