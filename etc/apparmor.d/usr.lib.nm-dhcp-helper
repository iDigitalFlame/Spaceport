include <tunables/spaceport>

profile nm-dhcp-helper /usr/lib/nm-dhcp-helper flags=(enforce) {
    include <abstractions/base>
    include <abstractions/dbus>
    include <abstractions/private-files>

    network                            inet  dgram,
    network                            inet6 dgram,

    signal send    peer=dhclient,
    signal receive peer=NetworkManager,

    ptrace readby peer=NetworkManager,

    /usr/lib/nm-dhcp-helper            rm,
    /var/lib/NetworkManager/*lease     r,

    @{run}/NetworkManager/private-dhcp rw,

    include if exists <local/usr.lib.nm-dhcp-helper>
}
