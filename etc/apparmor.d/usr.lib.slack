include <tunables/spaceport>

profile slack /usr/{bin,lib}/slack{,/slack} flags=(enforce, attach_disconnected) {
    include <abstractions/video>
    include <abstractions/version>
    include <abstractions/chromium>
    include <abstractions/user-home>
    include <abstractions/notifications>

    /usr/bin/slack                                           r,
    /usr/lib/slack/resources/**                              rm,

    owner @{CGROUP}/app.slice/sway.service/memory.{high,max} r,

    owner /proc/@{pid}/mem                                   r,

    owner @{HOME}/                                           r,

    @{run}/systemd/inhibit/*.ref                             rw,

    owner @{HOME}/.config/Slack/{,**}                        rwkl,

    /usr/bin/xdg-open                                        Pix -> xdg-open,
    /usr/bin/electron*                                       ixr,
    /usr/bin/xdg-email                                       Pix -> xdg-email,

    /usr/lib/electron*/{chrome_crashpad_handler,electron}    ix,

    deny ptrace read,

    deny /usr/bin/ldd                                        rx,
    deny /usr/bin/{,ba,da}sh                                 rx,
    deny /usr/bin/xdg-settings                               rx,

    include if exists <local/usr.lib.slack>
}
