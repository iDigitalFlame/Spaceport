include <tunables/spaceport>

# NOTE(dij): Only used for a profile translation when using symlinks for arg[0]
#            powerctl commands (eg in /usr/local/bin). Can only be selected via
#            another profile. This profile only has permissions for read-only
#            non-device stuff. (No hydra, backup or user config).
#
#            This is kept as a separate profile for reuse.
profile powerctl flags=(enforce) {
    include <abstractions/smd>
    include <abstractions/no-network>
    include <abstractions/private-files>

    /sys/class/net/                                        r,
    /sys/class/bluetooth/                                  r,
    /sys/devices/system/cpu/{,**}                          r,
    /sys/class/net/*/{flag,wireles}s                       r,
    /sys/class/bluetooth/*/rfkill*/state                   r,
    /sys/class/backlight/intel_backlight/{,max_}brightness r,

    include if exists <local/usr.lib.smd.smd-powerctl>
}
