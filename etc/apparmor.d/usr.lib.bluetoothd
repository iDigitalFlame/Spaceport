include <tunables/spaceport>

profile bluetoothd /usr/lib/bluetooth/bluetoothd flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/dbus-system>
    include <abstractions/private-files>

    capability                               net_admin,
    capability                               net_bind_service,

    network                                  alg       seqpacket,
    network                                  netlink   raw,
    network                                  bluetooth raw,
    network                                  bluetooth stream,
    network                                  bluetooth seqpacket,

    @{sysconfig}/etc/bluetooth/{,*.conf}     r,

    /                                        r,
    /etc/{os,arch}-release                   r,
    /etc/bluetooth/{,*.conf}                 r,
    /var/lib/bluetooth/{,**}                 rw,
    /usr/lib/bluetooth/bluetoothd            rm,

    /sys/devices/pci*/**/{uevent,name}       r,
    /sys/devices/pci**/**/rfkill*/name       r,
    /sys/devices/platform/**/rfkill/**/name  r,
    /sys/devices/virtual/dmi/id/chassis_type r,
    /sys/devices/virtual/misc/uhid/**/uevent r,

    /proc/version                            r,
    /proc/sys/kernel/hostname                r,

    @{run}/udev/data/+hid:*                  r,

    /dev/rfkill                              rw,
    /dev/hidraw*                             rw,
    /dev/u{hid,input}                        rw,

    @{run}/sdp                               rw,

    owner @{run}/systemd/notify              w,

    dbus (receive, send) bus=system interface=org.bluez,

    dbus receive bus=system path=/ interface=org.freedesktop.DBus.ObjectManager member=GetManagedObjects peer=(name=:*, label="{brave,NetworkManager,pulseaudio,upowerd}"),
    dbus receive bus=system path=/org/freedesktop/hostname1 interface=org.freedesktop.DBus.Properties member=PropertiesChanged peer=(name="{*,org.freedesktop.hostname1}", label=systemd-hostnamed),

    dbus send bus=system path=/MediaEndpoint interface=org.freedesktop.DBus.ObjectManager member=GetManagedObjects peer=(name=:*, label=pulseaudio),
    dbus send bus=system path=/org/freedesktop/hostname1 interface=org.freedesktop.DBus.Properties member={Get,GetAll} peer=(name=org.freedesktop.hostname1),
    dbus send bus=system path=/ interface=org.freedesktop.DBus.ObjectManager member=InterfacesRemoved peer=(name=org.freedesktop.DBus, label="{jwupd,NetworkManager,pulseaudio,upowerd}"),
    dbus send bus=system path=/org/freedesktop/hostname1 interface=org.freedesktop.DBus.Properties member={Get,GetAll} peer=(name="{*,org.freedesktop.hostname1}", label=systemd-hostnamed),

    include if exists <local/usr.lib.bluetoothd>
}
