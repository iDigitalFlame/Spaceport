include <tunables/spaceport>

profile polkit /usr/lib/{,polkit-1}/polkitd flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/no-network>
    include <abstractions/dbus-system>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                        setgid,
    capability                                        setuid,
    capability                                        sys_nice,
    capability                                        sys_ptrace,

    audit capability                                  net_admin,

    ptrace read,

    @{sysconfig}/etc/polkit-1/rules.d/spaceport.rules r,

    /etc/machine-id                                   r,
    /etc/polkit-1/rules.d/                            r,
    /usr/share/polkit-1/actions/                      r,
    /usr/lib/{,polkit-1}/polkitd                      rm,
    /etc/polkit-1/rules.d/*.rules                     r,
    /usr/share/polkit-1/rules.d{,/}                   r,
    /etc/polkit-1/actions/{,*.policy}                 r,
    /etc/polkit-1/localauthority/{,**}                r,
    /usr/share/polkit-1/rules.d/*.rules               r,
    /usr/share/polkit-1/actions/*.policy              r,
    /usr/local/share/polkit-1/rules.d{,/,/*}          r,
    /etc/polkit-1/localauthority.conf.d/{,**}         r,
    /var/lib/polkit{,-1}/localauthority/{,**}         r,
    /usr/share/polkit-1/actions/*.policy.choice       r,

    /proc/cmdline                                     r,
    /proc/1/environ                                   r,
    /proc/@{pid}/stat                                 r,
    /proc/@{pid}/fdinfo/*                             r,
    /proc/sys/kernel/osrelease                        r,
    /proc/@{pid}/c{mdline,group}                      r,
    /proc/@{pid}/task/@{tid}/stat                     r,

    @{run}/systemd/sessions/*                         r,
    @{run}/systemd/users/@{uid}                       r,
    @{run}/polkit-1/rules.d{,/,/*}                    r,

    owner /var/lib/polkit{,-1}/.cache/                rw,

    dbus send bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus member={GetConnectionUnixProcessID,GetConnectionUnixUser,GetConnectionCredentials} peer=(name=org.freedesktop.DBus, label=dbus-system),

    deny /.cache/                                     rw,

    include if exists <local/usr.lib.polkit>
}
