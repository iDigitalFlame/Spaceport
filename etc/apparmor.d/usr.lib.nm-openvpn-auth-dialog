include <tunables/spaceport>

profile nm-openvpn-auth-dialog /usr/lib/nm-openvpn-{auth-dialog,service-openvpn-helper} flags=(enforce) {
    include <abstractions/base>
    include <abstractions/no-network>

    /usr/lib/nm-openvpn-auth-dialog                rm,

    owner @{HOME}/.cert/nm-openvpn/*.pem           r,
    owner @{HOME}/.config/openvpn/nm-openvpn/*.pem r,

    include if exists <local/usr.lib.nm-openvpn-auth-dialog>
}
