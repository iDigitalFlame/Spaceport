include <tunables/spaceport>

profile xwayland /usr/bin/{X,x}wayland flags=(enforce, attach_disconnected) {
    include <abstractions/X>
    include <abstractions/base>
    include <abstractions/mesa>
    include <abstractions/fonts>
    include <abstractions/vulkan>
    include <abstractions/wayland>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    signal receive set=(hup, term),

    ptrace read,

    /usr/bin/xkbcomp                          rm,
    /usr/share/X11/xkb/**                     r,

    /sys/devices/**/manufacturer              r,
    /sys/devices/**/{produc,ueven}t           r,
    /sys/devices/**/{,subsystem_}vendor       r,
    /sys/devices/**/{,subsystem_}device       r,

    /proc/                                    r,
    /proc/@{pid}/cmdline                      r,

    /dev/fb*                                  rw,
    /dev/dri/card*                            rw,
    /dev/dri/render*                          rw,
    /dev/input/event*                         rw,

    owner @{run}/user/@{uid}/server-*.xkm     rwk,

    owner /tmp/server-*.xkm                   rwk,

    /usr/bin/xkbcomp                          Pxr -> xkbcomp,
    /usr/bin/{,ba,da,z}sh                     ix,
    /usr/bin/{X,x}wayland                     ixrm,

    deny /var/log/Xorg.*.log                  rw,
    deny @{HOME}/.xsession-errors{,.*}        rw,
    deny @{HOME}/.local/share/xorg/Xorg.*.log rw,

    include if exists <local/usr.bin.Xwayland>
}
