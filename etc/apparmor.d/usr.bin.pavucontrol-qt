include <tunables/spaceport>

profile pavucontrol-qt /usr/bin/pavucontrol-qt flags=(attach_disconnected, enforce) {
    include <abstractions/qt>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/no-network>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    /etc/machine-id                                    r,
    /usr/bin/pavucontrol-qt                            rm,
    /usr/share/pavucontrol-qt/**                       r,

    /sys/devices/pci*/**                               r,

    owner @{CONFIG}/pavucontrol-qt/pavucontrol-qt.conf r,

    owner @{HOME}/                                     r,

    deny @{CONFIG}/pavucontrol-qt/pavucontrol-qt.conf  w,

    include if exists <local/usr.bin.pavucontrol-qt>
}
