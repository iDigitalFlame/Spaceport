include <tunables/spaceport>

profile gtklock /usr/bin/gtklock flags=(enforce) {
    include <abstractions/gtk>
    include <abstractions/dconf>
    include <abstractions/nameservice>
    include <abstractions/authentication>
    include <abstractions/freedesktop.org>

    /etc/shells                                  r,

    /sys/{bu,clas}s/                             r,
    /sys/class/hidraw/                           r,

    /sys/devices/**/manufacturer                 r,
    /sys/devices/**/{produc,ueven}t              r,

    owner @{HOME}/.cache/smd/*                   r,
    owner @{HOME}/.config/Yubico/u2f_keys        r,

    /dev/hidraw*                                 rwk,

    owner @{run}/faillock/*                      rwk,
    owner @{run}/user/@{uid}/dconf/user          rw,
    owner @{run}/user/@{uid}/pam-u2f-authpending rw,

    /usr/bin/unix_chkpwd                         Pxr,

    deny network,

    include if exists <local/usr.bin.gtklock>
}
