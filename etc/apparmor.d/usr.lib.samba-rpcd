include <tunables/spaceport>

profile samba-rpcd /usr/lib*/samba/{,samba/}rpcd_{mdssvc,epmapper,rpcecho,fsrvp,lsad,winreg} flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/samba-rpcd>
    include <abstractions/private-files>

    /usr/lib*/samba/{,samba/}rpcd_{mdssvc,epmapper}           rm,
    /usr/lib*/samba/{,samba/}rpcd_{rpcecho,fsrvp,lsad,winreg} rm,

    @{run}/smd/hydra/smb.conf                                 r,

    /dev/cores/rpcd_lsad/                                     rw,
    /dev/cores/rpcd_winreg/{,**}                              rw,

    @{run}/samba/ncalrpc/np/winreg                            rw,

    include if exists <local/samba-rpcd>
    include if exists <local/usr.lib.samba-rpcd>
}
