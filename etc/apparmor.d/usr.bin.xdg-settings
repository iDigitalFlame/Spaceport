include <tunables/spaceport>

profile xdg-settings /usr/bin/xdg-settings flags=(enforce) {
    include <abstractions/base>
    include <abstractions/mime>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/user-data-ro>
    include <abstractions/dbus-session-strict>

    @{sysconfig}/bin/ghr                 Pix -> ghr,

    /usr/bin/xdg-settings                r,
    /usr/share/terminfo/**               r,
    /usr/share/icons/*/cursors/crosshair r,

    /proc/version                        r,

    owner /proc/@{pid}/fd/               r,

    owner @{run}/user/@{uid}/            r,

    owner @{CONFIG}/mimeapps.list        r,

    /usr/bin/ghr                         Pix -> ghr,
    /usr/bin/c{a,u}t                     ix,
    /usr/bin/{,e}grep                    ix,
    /usr/bin/xdg-mime                    Pxr -> xdg-mime,
    /usr/bin/xdg-email                   Px -> xdg-email,
    /usr/bin/{,g,m}awk                   ix,
    /usr/bin/s{ed,ort}                   ix,
    /usr/bin/w{c,hich}                   ix,
    /usr/bin/dbus-send                   ix,
    /usr/bin/m{v,ktemp}                  ix,
    /usr/bin/{,ba,da}sh                  ixr,
    /usr/bin/{u,base}name                ix,
    /usr/bin/rea{dlink,lpath}            ix,
    /usr/bin/{mimetype,tr,xprop}         ix,
    /usr/bin/{env,file,gio,head,printf}  ix,

    include if exists <local/usr.bin.xdg-settings>
}
