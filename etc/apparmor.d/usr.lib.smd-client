include <tunables/spaceport>

profile smd-client /{,opt/spaceport/}usr/lib/smd/libexec/smd-client flags=(enforce) {
    include <abstractions/smd>
    include <abstractions/wayland>

    signal send                 set=(alrm, cont, int, kill, quit, stop, term, usr1),
    signal send peer=unconfined set=(alrm, cont, int, kill, quit, stop, term, usr1),

    @{sysconfig}/usr/lib/smd/libexec/*                      Px,
    @{sysconfig}/usr/lib/smd/bin/powerctl                   Px -> powerctl,

    /usr/share/icons/**                                     r,

    /sys/class/power_supply/AC/online                       r,
    /sys/devices/platform/*/power_supply/AC/online          r,
    /sys/class/graphics/fb0/device/drm/card*/card*/status   r,
    /sys/class/graphics/fb0/device/drm/card*/card*/enabled  r,

    /proc/acpi/button/lid/LID0/state                        r,

    owner /proc/@{pid}/cgroup                               r,

    owner /opt/hydra/*/**                                   r,

    owner @{CONFIG}/theme/**                                r,

    owner @{HOME}/Pictures/Backgrounds{,/}                  r,
    owner @{HOME}/Pictures/Backgrounds/*.@{IMAGES}          r,

    owner @{run}/user/@{uid}/smd-client-*.log               rw,

    owner @{CONFIG}/smd.json                                rw,

    owner @{HOME}/.cache/smd/*                              rwl,

    /usr/bin/*                                              Pix,
    /usr/local/bin/*                                        Pix,
    /usr/lib/smd/libexec/*                                  Pix,
    /usr/lib/smd/bin/powerctl                               Px -> powerctl,

    owner @{HOMEDOTS}/.local/{apps,bin,lib}/**              Pixr,

    include if exists <local/usr.lib.smd-client>
}
