include <tunables/spaceport>

profile vncviewer /usr/bin/vncviewer flags=(attach_disconnected, enforce) {
    include <abstractions/gtk>
    include <abstractions/consoles>
    include <abstractions/private-files>

    network                                   inet  stream,
    network                                   inet6 stream,

    /usr/bin/vncviewer                        rm,

    owner @{CONFIG}/fltk/fltk.org/*.prefs     r,
    owner @{CONFIG}/tigervnc/default.tigervnc r,

    owner @{HOME}/                            r,

    @{run}/smd/hydra/*.vnc                    rw,

    deny /etc/fltk{,/,/*}                     rw,
    deny @{HOME}/.fltk{,/}                    w,
    deny @{CONFIG}/fltk/fltk.org/*.prefs      w,
    deny @{HOME}/.local/share/tigervnc{,/**}  rw,
    deny @{CONFIG}/tigervnc/default.tigervnc  w,

    include if exists <local/usr.bin.vncviewer>
}
