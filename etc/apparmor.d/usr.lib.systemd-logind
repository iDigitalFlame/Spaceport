include <tunables/spaceport>

profile systemd-logind /usr/lib/systemd/systemd-logind flags=(attach_disconnected, enforce, mediate_deleted) {
    include <abstractions/base>
    include <abstractions/cgroup>
    include <abstractions/consoles>
    include <abstractions/dbus-system>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                           chown,
    capability                                           fowner,
    capability                                           sys_admin,
    capability                                           dac_override,
    capability                                           sys_tty_config,
    capability                                           dac_read_search,

    network                                              netlink raw,

    ptrace read peer=unconfined,

    mqueue r type=posix /,

    @{sysconfig}/etc/systemd/sleep.conf                  r,
    @{sysconfig}/etc/systemd/logind.conf                 r,

    /boot/                                               r,
    /boot/**/*.efi                                       r,
    /boot/{efi,EFI,esp/EFI}/Linux/                       r,
    /boot/{,esp}/loader/loader.conf                      r,

    /                                                    r,
    /etc/machine-id                                      r,
    /usr/lib/systemd-login                               rm,
    /etc/systemd/sleep.conf                              r,
    /var/lib/systemd/linger/                             r,
    /etc/systemd/logind.conf                             r,
    /etc/systemd/sleep.conf.d/{,**}                      r,
    /etc/systemd/logind.conf.d/{,**}                     r,

    /dev/                                                r,
    /dev/*pool/                                          r,
    /dev/block/                                          r,
    /dev/mqueue/                                         r,
    /dev/disk/{,*/}                                      r,
    /dev/zvol/{,*/}                                      r,
    /dev/bus/usb/{,*/}                                   r,

    /sys/block/                                          r,
    /sys/bus/usb/                                        r,
    /sys/devices/                                        r,
    /sys/dev/block/                                      r,
    /sys/class/drm/                                      r,
    /sys/class/usbmisc/                                  r,
    /sys/class/power_supply/                             r,
    /sys/devices/**/host*/**                             r,
    /sys/kernel/kexec_loaded                             r,
    /sys/{bu,clas}s/{,block/}                            r,
    /sys/fs/cgroup/memory.max                            r,
    /sys/bus/usb/devices/{,**}                           r,
    /sys/devices/**/usb*/{,**}                           r,
    /sys/devices/pci*/**/ata*/**                         r,
    /sys/devices/pci*/**/host*/**                        r,
    /sys/devices/pci*/**/virtio*/**                      r,
    /sys/power/{state,resume*,disk}                      r,
    /sys/devices/platform/**/mmc*/{,**}                  r,
    /sys/devices/pci*/**/mmc*/mmc*/{,**}                 r,
    /sys/devices/virtual/block/zd*/{,**}                 r,
    /sys/devices/pci*/**/nvme/nvme*/{,**}                r,
    /sys/devices/virtual/block/dm-*/{,**}                r,
    /sys/devices/virtual/block/nbd*/{,**}                r,
    /sys/devices/virtual/tty/tty@*/active                r,
    /sys/devices/virtual/block/loop*/{,**}               r,
    /sys/devices/virtual/block/zram*/{,**}               r,
    /sys/firmware/efi/efivars/LoaderInfo-*               r,
    /sys/firmware/efi/efivars/SecureBoot-*               r,
    /sys/module/vt/parameters/default_utf8               r,
    /sys/devices/pci*/**/block/mmcblk*/{,**}             r,
    /sys/bus/serial-base/drivers/port/uevent             r,
    /sys/firmware/efi/efivars/OsIndications-*            r,
    /sys/firmware/efi/efivars/LoaderEntries-*            r,
    /sys/firmware/efi/efivars/LoaderFeatures-*           r,
    /sys/fs/cgroup/memory/memory.limit_in_bytes          r,
    /sys/devices/pci*/**/block/{s,v}d[a-z]/{,**}         r,
    /sys/devices/platform/**/block/mmcblk*/{,**}         r,
    /sys/devices/platform/floppy.*/block/fd*/{,**}       r,
    /sys/firmware/efi/efivars/OsIndicationsSupported-*   r,

    /proc/swaps                                          r,
    /proc/1/sched                                        r,
    /proc/cmdline                                        r,
    /proc/1/cgroup                                       r,
    /proc/1/cmdline                                      r,
    /proc/1/environ                                      r,
    /proc/pressure/*                                     r,
    /proc/@{pid}/fd/                                     r,
    /proc/@{pid}/stat                                    r,
    /proc/@{pid}/fdinfo/*                                r,
    /proc/@{pid}/mountinfo                               r,
    /proc/@{pid}/sessionid                               r,
    /proc/@{pid}/c{group,omm}                            r,
    /proc/sys/kernel/osrelease                           r,
    /proc/sysvipc/{shm,sem,msg}                          r,
    /proc/sys/kernel/random/boot_id                      r,

    @{run}/utmp                                          rk,
    @{run}/udev/data/{b,c}*:*                            r,
    @{run}/udev/tags/uaccess/                            r,
    @{run}/udev/data/+wakeup:*                           r,
    @{run}/udev/data/+drivers:*                          r,
    @{run}/udev/data/+backlight:*                        r,
    @{run}/udev/data/+drm:card*-*                        r,
    @{run}/host/container-manager                        r,
    @{run}/udev/data/+input:input*                       r,
    @{run}/udev/tags/power-switch/                       r,
    @{run}/udev/tags/master-of-seat/                     r,
    @{run}/udev/static_node-tags/uaccess/                r,
    @{run}/credentials/getty@tty*.service/               r,
    @{run}/udev/data/+{hid,i2c,leds,pci,usb}:*           r,

    owner /proc/@{pid}/stat                              r,

    /sys/devices/pci*/**/usb*/**                         rw,
    /sys/devices/**{,/brightness}                        rw,

    /dev/sr*                                             rwk,
    /dev/dm-*                                            rwk,
    /dev/nbd*                                            rwk,
    /dev/tty*                                            rw,
    /dev/kmsg                                            w,
    /dev/zram*                                           rwk,
    /dev/{f,z}d*                                         rwk,
    /dev/dri/card*                                       rw,
    /dev/loop[0-9]*                                      rwk,
    /dev/nvme[0-9]*                                      rwk,
    /dev/bus/usb/*/*                                     rwk,
    /dev/mapper/{,*}                                     rwk,
    /dev/{s,v}d[a-z]*                                    rwk,
    /dev/input/event*                                    rw,
    /dev/loop[0-9]*p*                                    rwk,
    /dev/mmcblk[0-9]*                                    rwk,
    /dev/{s,v}d[a-z]**                                   rwk,
    /dev/mmcblk[0-9]*p*                                  rwk,

    @{run}/systemd/io*                                   rw,
    @{run}/systemd/notify                                w,
    @{run}/systemd/seats/                                rw,
    @{run}/systemd/users/                                rw,
    @{run}/systemd/seats/*                               rwkl,
    @{run}/systemd/users/*                               rwkl,
    @{run}/{,.#}nologin{,*}                              rw,
    @{run}/systemd/inhibit/                              rw,
    @{run}/systemd/inhibit/*                             rwkl,
    @{run}/systemd/sessions/                             rw,
    @{run}/systemd/shutdown/                             rw,
    @{run}/systemd/sessions/*                            rwkl,
    @{run}/systemd/shutdown/*                            rwkl,
    @{run}/systemd/userdb/io.systemd.Multiplexer         rw,

    @{CGROUP_SYS}/systemd-logind.service/memory.pressure rw,

    owner /dev/shm/{,**/}                                rw,

    unix bind type=stream addr="@*/bus/systemd-logind/system",

    dbus bind bus=system name=org.freedesktop.login1,

    dbus (receive, send) bus=system interface=org.freedesktop.login1,
    dbus (receive, send) bus=system interface=org.freedesktop.systemd1,

    dbus receive bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=Changed peer=(name=*, label=polkitd),
    dbus receive bus=system path=/org/freedesktop/login*{,/seat/auto,session/_*} interface=org.freedesktop.DBus.Introspectable member=Introspect peer=(label=ksmserver-logout-greeter),

    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.DBus.Properties member=GetAll peer=(name=*, label=polkitd),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.DBus.Introspectable member=Introspect peer=(name=*, label=polkitd),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=*, label=polkitd),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=org.freedesktop.PolicyKit1),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=org.freedesktop.PolicyKit1, label=polkitd),
    dbus send bus=system path=/org/freedesktop/DBus interface=org.freedesktop.DBus member={GetConnectionUnixUser,GetConnectionUnixProcessID,GetConnectionCredentials} peer=(name=org.freedesktop.DBus, label=dbus-system),

    include if exists <local/usr.lib.systemd-logind>
}
