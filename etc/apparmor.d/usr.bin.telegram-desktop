include <tunables/spaceport>

profile telegram-desktop /usr/bin/{T,t}elegram{,-desktop} flags=(enforce) {
    include <abstractions/qt>
    include <abstractions/dri>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/gnome>
    include <abstractions/video>
    include <abstractions/cgroup>
    include <abstractions/p11-kit>
    include <abstractions/xdg-open>
    include <abstractions/user-home>
    include <abstractions/dbus-strict>
    include <abstractions/nameservice>
    include <abstractions/xdg-desktop>
    include <abstractions/notifications>
    include <abstractions/dbus-session-strict>
    include <abstractions/dbus-accessibility-strict>
    include <abstractions/dbus-network-manager-strict>

    network                                         inet  stream,
    network                                         inet6 stream,

    /                                               r,
    /etc/{os,arch}-release                          r,

    /sys/devices/virtual/dmi/id/bios_vendor         r,
    /sys/devices/virtual/dmi/id/chassis_type        r,
    /sys/devices/virtual/dmi/id/product_family      r,
    /sys/kernel/mm/transparent_hugepage/enabled     r,

    /proc/version                                   r,
    /proc/zoneinfo                                  r,
    /proc/sys/net/ipv6/conf/all/disable_ipv6        r,

    owner /proc/@{pid}/{cmdline,stat,statm}         r,

    owner /proc/@{pid}/comm                         rw,
    owner /proc/@{pid}/task/@{tid}/comm             rw,

    owner @{run}/user/@{uid}/qtwayland-*            rwk,
    owner @{run}/user/@{uid}/*-wayland{,.lock}      rwk,

    owner @{CACHE}/TelegramDesktop{,/,/**}          rw,

    owner @{HOME}/.local/share/TelegramDesktop/**   rwkl,
    owner @{HOME}/.local/share/TelegramDesktop/{,*} rw,

    /usr/bin/xdg-open                               Pix -> xdg-open,
    /usr/bin/xdg-email                              Pix -> xdg-email,
    /usr/bin/xdg-settings                           Pix -> xdg-settings,
    /usr/bin/{T,t}elegram{,-desktop}                ixr,
    /usr/lib/webkit2gtk-4.1/WebKit*Process          Pix -> webkit,

    deny /sys/class/power_supply/                   r,
    deny @{HOME}/.local/share/applications/**       w,

    include if exists <local/usr.bin.telegram-desktop>
}
