include <tunables/spaceport>

profile systemd-timesyncd /usr/lib/systemd/systemd-timesyncd flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/dbus-system>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                              sys_time,

    network                                                 inet  dgram,
    network                                                 inet6 dgram,
    network                                                 inet  stream,
    network                                                 inet6 stream,

    ptrace read peer=unconfined,

    @{sysconfig}/etc/systemd/timesyncd.conf                 r,

    /                                                       r,
    /etc/systemd/timesyncd.conf                             r,
    /usr/lib/systemd/systemd-timesyncd                      rm,
    /etc/systemd/timesyncd.conf.d/{,**}                     r,

    /sys/firmware/efi/efivars/SecureBoot-*                  r,

    /proc/1/sched                                           r,
    /proc/cmdline                                           r,
    /proc/1/cgroup                                          r,
    /proc/1/environ                                         r,
    /proc/pressure/*                                        r,
    /proc/@{pid}/cgroup                                     r,
    /proc/sys/kernel/osrelease                              r,
    /proc/sys/kernel/random/boot_id                         r,

    @{run}/systemd/netif/{links/*,state}                    r,
    @{run}/systemd/timesyncd.conf.d/{,**}                   r,

    owner /proc/@{pid}/stat                                 r,

    /dev/kmsg                                               w,

    @{run}/systemd/notify                                   rw,

    @{CGROUP_SYS}/systemd-timesyncd.service/memory.pressure rw,

    owner /var/lib/systemd/timesync/clock                   rw,

    owner @{run}/systemd/timesync/synchronized              rw,

    unix bind type=stream addr="@*/bus/systemd-timesyn/bus-api-timesync",

    unix (receive, send) type=dgram addr=none peer=(label=unconfined, addr=none),

    dbus bind bus=system name=org.freedesktop.timesync1,

    dbus (receive, send) interface=org.freedesktop.timesync1,

    include if exists <local/usr.lib.systemd-timesyncd>
}
