include <tunables/spaceport>

profile spicy /usr/bin/spicy flags=(enforce, attach_disconnected) {
    include <abstractions/gtk>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/video>
    include <abstractions/cgroup>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/glycin-base>
    include <abstractions/nameservice>
    include <abstractions/xdg-desktop>
    include <abstractions/private-files>
    include <abstractions/freedesktop.org>

    # For USB redirection.
    capability                                    fowner,

    /etc/machine-id                               r,
    /usr/share/hwdata/usb.ids                     r,
    /usr/share/glib-2.0/schemas/gschemas.compiled r,

    /dev/                                         r,
    /dev/shm/                                     r,
    /dev/media*                                   r,
    /dev/bus/usb/                                 r,

    /sys/{bu,clas}s/                              r,
    /sys/bus/media/devices/                       r,
    /sys/devices/pci*/uevent                      r,

    /proc/@{pid}/stat                             r,
    /proc/@{pid}/fdinfo/@{tid}{,/,/comm}          r,

    owner /proc/@{pid}/fd/                        r,

    owner @{CONFIG}/spicy/settings                r,

    owner @{HOME}/.local/share/                   r,

    /dev/bus/usb/*/*                              rw,

    /sys/bus/usb/devices/{,*/**}                  rw,

    @{run}/udev/data/c*:*                         rw,
    @{run}/smd/hydra/*.spice                      rw,
    @{run}/udev/data/+usb{,-serial}:*             rw,

    /tmp/orcexec.*                                rwm,

    owner @{CACHE}/gstreamer-1.0/registry.*       rw,

    /usr/bin/spicy-s{creenshot,tats}              ix,
    /usr/lib/gstreamer-1.0/gst-plugin-scanner     ix,
    /usr/lib/spice-client-glib-usb-acl-helper     ix,

    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.DBus.Properties member=GetAll peer=(name=*, label=polkitd),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.DBus.Introspectable member=Introspect peer=(name=*, label=polkitd),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=*, label=polkitd),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=org.freedesktop.PolicyKit1),
    dbus send bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=CheckAuthorization peer=(name=org.freedesktop.PolicyKit1, label=polkitd),

    dbus receive bus=system path=/org/freedesktop/PolicyKit1/Authority interface=org.freedesktop.PolicyKit1.Authority member=Changed peer=(name=*, label=polkitd),

    deny @{HOME}/orcexec{,*}                      rw,
    deny @{CONFIG}/spicy/settings{,*}             w,
    deny @{run}/user/@{uid}/orcexec{,*}           rw,

    include if exists <local/usr.bin.spicy>
}
