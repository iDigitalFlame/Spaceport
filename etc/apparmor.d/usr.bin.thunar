include <tunables/spaceport>

profile thunar /usr/bin/{T,t}hunar flags=(enforce, attach_disconnected) {
    include <abstractions/gtk>
    include <abstractions/dconf>
    include <abstractions/consoles>
    include <abstractions/user-data>
    include <abstractions/no-network>
    include <abstractions/glycin-base>
    include <abstractions/xdg-desktop>

    # Needed to open any files for reading.
    /{,**}                                                 r,

    /usr/lib/tumbler-*/plugins/*                           rm,
    /usr/share/thumbnailers/*.thumbnailer                  r,

    owner @{HOME}/**                                       l,

    owner @{CONFIG}/Thunar/*.xml                           r,
    owner @{CONFIG}/xfce4/xfconf/xfce-*-xml/thunar.xml     r,

    owner /tmp/**                                          rwl,

    owner @{HOME}/.config/Thunar/accels.scm                rw,

    /usr/bin/dash                                          ix,
    /usr/bin/kitty                                         Px -> kitty,
    /usr/bin/xdg-open                                      PUx,
    /usr/bin/xdg-settings                                  PUx,
    /usr/bin/ffmpegthumbnailer                             ix,
    /usr/lib/gio-launch-desktop                            PUx,
    # NOTE(dij): ^ Thunar has unrestricted execute permissions as it's needed to
    #            open any file when using it to browse the filesystem.

    deny @{CONFIG}/Thunar/*.xml                            w,
    deny /systemd/journal/stdout                           rw,
    deny @{CONFIG}/xfce4/xfconf/xfce-*-xml/*.xml           w,
    deny @{HOME_DATA}/.local/share/applications/mimeapps.* w,

    include if exists <local/usr.bin.thunar>
}
