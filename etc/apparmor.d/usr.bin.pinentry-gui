include <tunables/spaceport>

profile pinentry-gui /usr/bin/pinentry-{gnome3,gtk,qt*,*} flags=(enforce) {
    include <abstractions/qt>
    include <abstractions/gtk>
    include <abstractions/gnome>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/private-files>
    include <abstractions/dbus-session-strict>

    signal receive set=(int) peer=gpg-agent,

    ptrace read,

    /etc/machine-id            r,
    /usr/share/gtk-*/{,**}     r,
    /usr/share/terminfo/**     r,
    /var/lib/dbus/machine-id   r,

    owner /proc/@{pid}/cmdline r,

    owner /tmp/xauth_*         r,

    owner /dev/shm/#*          rw,

    /usr/lib/ld{-*,d}          ixr,
    /usr/bin/{,ba,da,z}sh      ixr,
    /usr/bin/pinentry{,-*}     Pxrm,

    include if exists <local/usr.bin.pinentry-gui>
}
