include <tunables/spaceport>

profile qFlipper /usr/bin/qFlipper flags=(enforce) {
    include <abstractions/qt>
    include <abstractions/chromium>
    include <abstractions/user-home>
    include <abstractions/xdg-desktop>
    include <abstractions/private-files>

    # This is here to allow for in-memory blob locking
    /**                                                 kl,

    /usr/bin/qFlipper                                   rm,

    /dev/bus/usb/                                       r,

    /sys/class/tty/                                     rm,
    /sys/{bu,clas}s/                                    r,
    /sys/bus/usb/devices/                               r,
    /sys/devices/platform/uevent                        r,
    /sys/devices/virtual/tty/*/uevent                   r,
    /sys/devices/pnp*/**/tty/tty*/uevent                r,
    /sys/devices/platform/serial*/uevent                r,
    /sys/devices/platform/serial*/serial*/uevent        r,
    /sys/devices/pci*/**/usb*/{,**/}{bus,dev}num        r,
    /sys/devices/p{ci,np}*/{,*/,*/*/,*/*/*/}uevent      r,
    /sys/devices/platform/serial*/*/serial*/uevent      r,
    /sys/devices/platform/serial*/**/tty/tty*/uevent    r,
    /sys/devices/pci*/**/usb*/{,**/}{descriptors,speed} r,

    @{run}/udev/data/c*:*                               r,
    @{run}/udev/data/+usb:*                             r,

    /dev/bus/usb/*/*                                    rw,
    /dev/tty{ACM,USB}*                                  rw,

    owner @{HOME}/.local/share/qFlipper{,/,/*}          rw,
    owner @{HOME}/.cache/Flipper\ Devices\ Inc/**       rwk,
    owner @{HOME}/.cache/Flipper\ Devices\ Inc{,/}      rw,
    owner @{HOME}/.config/Flipper\ Devices\ Inc/**      rwk,
    owner @{HOME}/.config/Flipper\ Devices\ Inc{,/}     rw,

    include if exists <local/usr.bin.qFlipper>
}
