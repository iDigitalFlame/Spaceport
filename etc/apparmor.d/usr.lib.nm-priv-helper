include <tunables/spaceport>

profile nm-priv-helper /usr/lib/nm-priv-helper flags=(enforce) {
    include <abstractions/base>
    include <abstractions/no-network>
    include <abstractions/private-files>

    capability              dac_override,

    /usr/lib/nm-priv-helper rm,

    dbus bind bus=system name=org.freedesktop.nm_priv_helper,

    dbus (receive, send) bus=system interface=org.freedesktop.nm_priv_helper,

    include if exists <local/usr.lib.nm-priv-helper>
}
