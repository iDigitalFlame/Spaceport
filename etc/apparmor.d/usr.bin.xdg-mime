include <tunables/spaceport>

profile xdg-mime /usr/bin/xdg-mime flags=(enforce) {
    include <abstractions/base>
    include <abstractions/mime>
    include <abstractions/consoles>
    include <abstractions/xdg-open>
    include <abstractions/no-network>
    include <abstractions/xdg-desktop>
    include <abstractions/user-data-ro>
    include <abstractions/dbus-session-strict>

    /proc/version                                                r,

    owner /tmp/wl-copy-buffer-*/stdin                            r,

    owner @{CONFIG}/mimeapps.list                                r,

    /usr/bin/printf                                              ix,
    /usr/bin/c{a,u}t                                             ix,
    /usr/bin/{,e}grep                                            ix,
    /usr/bin/{,g,m}awk                                           ix,
    /usr/bin/s{ed,ort}                                           ix,
    /usr/bin/w{c,hich}                                           ix,
    /usr/bin/dbus-send                                           ix,
    /usr/bin/m{v,ktemp}                                          ix,
    /usr/bin/{,ba,da}sh                                          ixr,
    /usr/bin/{u,base}name                                        ix,
    /usr/bin/rea{dlink,lpath}                                    ix,
    /usr/bin/{env,file,gio,head}                                 ix,
    /usr/bin/{mimetype,tr,xprop}                                 ix,

    deny @{HOMEDOTS}/.local/share/applications/mimeapps.list.new rw,

    include if exists <local/usr.bin.xdg-mine>
}
