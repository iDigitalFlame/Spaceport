include <tunables/spaceport>

profile dnsmasq /usr/bin/dnsmasq flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/dbus>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                     chown,
    capability                     setgid,
    capability                     setuid,
    capability                     net_raw,
    capability                     net_admin,
    capability                     dac_override,
    capability                     net_bind_service,

    network                        inet raw,
    network                        inet6 raw,

    signal (receive) peer=smd-daemon,

    ptrace (readby) peer=smd-daemon,

    /usr/share/dnsmasq{/,/*}       r,
    /usr/{bin,sbin}/dnsmasq        rm,

    /proc/sys/net/ipv6/conf/*/mtu  r,

    @{run}/dnsmasq{/,/*}           r,
    @{run}/dnsmasq-forwarders.conf r,

    @{run}/dnsmasq/*               rw,

    @{run}/*dnsmasq*.pid           w,

    include if exists <local/usr.bin.dnsmasq>
    include if exists <local/usr.sbin.dnsmasq>
}
