include <tunables/spaceport>

profile waybar /usr/bin/waybar flags=(enforce, attach_disconnected) {
    include <abstractions/dri>
    include <abstractions/gtk>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/vulkan>
    include <abstractions/wayland>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/nameservice>
    include <abstractions/private-files>
    include <abstractions/freedesktop.org>

    /usr/bin/waybar                             rm,
    /etc/machine-id                             r,
    /opt/*/**/icons/*/*.{ico,png,svg}           r,

    /dev/rfkill                                 r,

    /sys/devices/pci*/**/uevent                 r,
    /sys/class/power_supply/{,**}               r,
    /sys/devices/**/power_supply/**             r,
    /sys/devices/system/cpu/present             r,
    /sys/devices/virtual/dmi/id/*_{name,vendor} r,

    owner /proc/@{pid}/net/dev                  r,

    owner @{CONFIG}/waybar/{,*}                 r,

    /tmp/gdkpixbuf-xpm-tmp.*                    rw,

    owner /proc/@{pid}/task/@{tid}/comm         rw,

    /usr/bin/wpctl                              ix,
    /usr/bin/swaymsg                            ix,
    /usr/bin/{,ba,da,z}sh                       ix,

    include if exists <local/usr.bin.waybar>
}
