include <tunables/spaceport>

profile obs /usr/bin/obs flags=(enforce, attach_disconnected) {
    include <abstractions/dri>
    include <abstractions/gui>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/video>
    include <abstractions/vulkan>
    include <abstractions/openssl>
    include <abstractions/consoles>
    include <abstractions/user-home>
    include <abstractions/no-network>
    include <abstractions/nameservice>

    /usr/bin/obs                            r,
    /etc/machine-id                         r,
    /usr/share/obs/**                       r,
    /etc/udev/hwdb.bin                      r,
    /usr/share/obs/**/*.so                  rm,
    /usr/share/hwdata/pci.ids               r,

    /sys/devices/virtual/dmi/id/bios_vendor r,

    /proc/modules                           r,
    /proc/@{pid}/net/unix                   r,

    owner /proc/@{pid}/stat{,m}             r,
    owner /proc/@{pid}/task/@{tid}/**       r,

    owner @{HOME}/.config/QtProject.conf    r,

    owner @{HOME}/.config/obs-studio/{,**}  rw,

    /usr/bin/obs-ffmpeg-mux                 ix,

    deny /usr/bin/{,ba,da}sh                x,
    deny /usr/bin/xdg-screensaver           xr,
    owner @{HOME}/.config/QtProject.conf    w,

    deny ptrace,

    include if exists <local/usr.bin.obs>
}
