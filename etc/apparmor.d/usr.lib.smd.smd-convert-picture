include <tunables/spaceport>

profile smd-convert-picture /{,opt/spaceport/}usr/lib/smd/libexec/smd-convert-picture flags=(attach_disconnected, enforce) {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/glycin-base>
    include <abstractions/private-files>

    @{sysconfig}/usr/lib/smd/libexec/smd-convert-picture r,

    /etc/ImageMagick-*/*.xml                             r,
    /usr/share/ImageMagick-*/*.xml                       r,
    /usr/lib/smd/libexec/smd-convert-picture             r,

    owner @{HOME}/**/*.@{IMAGES}                         r, # For pictures and backgrounds.

    owner @{CACHE}/smd{,/}                               rw,
    owner @{CACHE}/smd/*.@{IMAGES}                       rw,

    /usr/bin/cp                                          ix,
    /usr/bin/ln                                          ix,
    /usr/bin/dash                                        ixr,
    /usr/bin/magick                                      ix,
    /usr/bin/convert                                     ixr,
    /usr/bin/jpegtran                                    ix,

    include if exists <local/usr.lib.smd.smd-convert-picture>
}
