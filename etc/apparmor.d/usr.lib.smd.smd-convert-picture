include <tunables/spaceport>

profile smd-convert-picture /{,opt/spaceport/}usr/lib/smd/libexec/smd-convert-picture flags=(enforce) {
    include <abstractions/base>
    include <abstractions/private-files>

    @{sysconfig}/usr/lib/smd/libexec/smd-convert-picture r,

    /usr/lib/smd/libexec/smd-convert-picture             r,

    # NOTE(dij): For pictures and backgrounds.
    owner @{HOME}/**/*.{jpg,jpeg,png,bmp,tiff,tga,heic}  r,

    owner @{HOME}/.cache/smd{,/}                         rw,
    owner @{HOME}/.cache/smd/*.{jp,pn}g                  rw,

    /usr/bin/cp                                          ix,
    /usr/bin/dash                                        ixr,
    /usr/bin/convert                                     ixr,

    deny network,

    include if exists <local/usr.lib.smd.smd-convert-picture>
}
