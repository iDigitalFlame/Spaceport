include <tunables/spaceport>

profile systemd-userdbd /usr/lib/systemd/systemd-userdbd flags=(enforce, attach_disconnected, mediate_deleted) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                              sys_resource,
    capability                                              dac_read_search,

    network                                                 inet    raw,
    network                                                 inet6   raw,
    network                                                 netlink raw,
    network                                                 inet    dgram,
    network                                                 inet6   dgram,

    ptrace read peer=unconfined,

    /etc/{,g}shadow                                         r,
    /etc/machine-id                                         r,
    /usr/lib/systemd/systemd-userdbd                        rm,

    /sys/firmware/efi/efivars/SecureBoot-*                  r,

    /proc/1/sched                                           r,
    /proc/cmdline                                           r,
    /proc/1/cgroup                                          r,
    /proc/1/environ                                         r,
    /proc/pressure/io                                       r,
    /proc/pressure/cpu                                      r,
    /proc/@{pid}/cgroup                                     r,
    /proc/pressure/memory                                   r,
    /proc/sys/kernel/osrelease                              r,
    /proc/sys/kernel/random/boot_id                         r,

    owner /proc/@{pid}/stat                                 r,

    @{run}/systemd/notify                                   w,
    @{run}/systemd/userdb/{,**}                             rw,
    @{run}/systemd/userdb/io.systemd.Home                   rw,
    @{run}/systemd/userdb/io.systemd.Machine                rw,
    @{run}/systemd/userdb/io.systemd.DynamicUser            rw,

    @{CGROUP_SYS}/systemd-timesyncd.service/memory.pressure rw,

    /usr/lib/systemd/systemd-userwork                       ixr,

    include if exists <local/usr.lib.systemd-userdbd>
}
