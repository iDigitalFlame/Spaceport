include <tunables/spaceport>

profile vlc /usr/bin/{,c,n,q,r,s,v}lc flags=(attach_disconnected, enforce) {
    include <abstractions/qt>
    include <abstractions/dri>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/gnome>
    include <abstractions/video>
    include <abstractions/vulkan>
    include <abstractions/openssl>
    include <abstractions/p11-kit>
    include <abstractions/user-home>
    include <abstractions/dbus-strict>
    include <abstractions/nameservice>
    include <abstractions/dbus-session-strict>
    include <abstractions/dbus-accessibility-strict>

    /usr/bin/vlc                        rm,
    /usr/lib/vlc/**                     rm,
    /usr/share/vlc/**                   r,
    /usr/share/hwdata/pnp.ids           r,

    /dev/                               r,
    /dev/sr*                            r,
    /dev/tty                            r,
    /dev/dvb/**                         r,

    owner /proc/@{pid}/cmdline          r,

    owner @{CONFIG}/vlc{,/,/*}          r,

    owner @{HOME}/.local/share/vlc/**   r,

    deny @{CACHE}/vlc{,/,/**}           w,
    deny @{CONFIG}/vlc{,/,/*}           w,
    deny /usr/bin/xdg-screensaver       xr,
    deny @{HOME}/.local/share/vlc{,/**} rw,

    include if exists <local/usr.bin.vlc>
}
