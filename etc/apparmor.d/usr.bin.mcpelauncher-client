include <tunables/spaceport>

profile mcpelauncher-client /usr/bin/mcpelauncher-client flags=(enforce) {
    include <abstractions/qt>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/video>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/ssl_certs>
    include <abstractions/glycin-base>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    network                                               inet  dgram,
    network                                               inet6 dgram,
    network                                               inet  stream,
    network                                               inet6 stream,

    /etc/machine-id                                       r,
    /usr/share/mcpelauncher/**                            rm,
    /usr/bin/mcpelauncher-client                          rm,

    /sys/bus/                                             r,
    /sys/class/{,input/}                                  r,
    /sys/devices/pci*/uevent                              r,
    /sys/devices/platform/uevent                          r,
    /sys/devices/LNXSYSTM*/{,**/}uevent                   r,
    /sys/devices/virtual/input/mice/uevent                r,
    /sys/devices/platform/i8042/{,**/}uevent              r,
    /sys/devices/system/cpu/{kernel_max,present}          r,
    /sys/devices/**/input*/input*/{,event*/}uevent        r,
    /sys/devices/platform/{INTC1051,PNP0}*/{,**/}uevent   r,
    /sys/devices/platform/**/input/input*/mouse*/uevent   r,

    /proc/sys/net/ipv6/conf/all/disable_ipv6              r,

    @{run}/udev/data/c13:*                                r,
    @{run}/udev/data/+input:input*                        r,

    owner /proc/@{pid}/comm                               r,
    owner /proc/@{pid}/statm                              r,

    owner /crash/                                         rw,
    owner /bootstrap_settings.json                        rw,

    owner /tmp/imgui.ini                                  rw,

    owner @{CACHE_TEMP}/minecraft/{,**}                   rw,

    owner @{HOME}/.local/share/mcpelauncher{,/**}         rwk,
    owner @{HOME}/.local/share/mcpelauncher/mods/*.so     rm,
    owner @{HOME}/.local/share/mcpelauncher/mods/**/*.so  rm,
    owner @{HOME}/.local/share/mcpelauncher/versions/*/** rwm,

    /usr/bin/dash                                         ix,

    owner @{HOME_DATA}/.local/bin/zenity                  ixr,

    include if exists <local/usr.bin.mcpelauncher-client>
}
