include <tunables/spaceport>

profile gnome-connections /usr/bin/gnome-connections flags=(enforce, attach_disconnected) {
    include <abstractions/dri>
    include <abstractions/dconf>
    include <abstractions/gnome>
    include <abstractions/cgroup>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/glycin-base>
    include <abstractions/private-files>

    mount fstype=fuse options=(rw nosuid nodev) -> @{run}/user/@{uid}/clipboard-*/,

    /usr/bin/gnome-connections                rm,

    /proc/sys/net/ipv6/conf/all/disable_ipv6  r,

    owner @{HOME}/.config{,/}                 r,

    /dev/fuse                                 rw,

    owner @{run}/user/@{uid}/clipboard-*/     rw,

    owner @{HOME}/.config/connections.db{,.*} rw,

    /usr/bin/vncviewer                        Px -> vncviewer,
    /usr/bin/fusermount*                      Px -> fusermount,
    /usr/bin/{wl,x}freerdp{,2,3}              Px -> freerdp,

    include if exists <local/usr.bin.gnome-connections>
}
