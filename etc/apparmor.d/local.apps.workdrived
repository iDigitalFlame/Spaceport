include <tunables/spaceport>

profile workdrive @{HOME}/.local/apps/zohoworkdrive/zohoworkdrived flags=(attach_disconnected, enforce) {
    include <abstractions/dri>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/gnome>
    include <abstractions/vulkan>
    include <abstractions/openssl>
    include <abstractions/p11-kit>
    include <abstractions/consoles>
    include <abstractions/nameservice>
    include <abstractions/notifications>
    include <abstractions/private-files>

    network                                                                 inet  stream,
    network                                                                 inet6 stream,

    @{sysconfig}/bin/hostname                                               ix,

    /**                                                                     kl, # This is here to allow for in-memory blob locking

    /etc/machine-id                                                         r,
    /etc/{os,arch}-release                                                  r,

    /sys/class/block/                                                       r,
    /sys/devices/pci*/**/dev                                                r,
    /sys/devices/system/node/                                               r,
    /sys/devices/virtual/block/{,*/dev}                                     r,
    /sys/devices/virtual/dmi/id/chassis_type                                r,
    /sys/devices/system/cpu/cpu*/cpu_capacity                               r,
    /sys/devices/virtual/dmi/id/{board,product}_{family,name}               r,

    /proc/                                                                  r,
    /proc/uptime                                                            r,
    /proc/version                                                           r,
    /proc/partitions                                                        r,
    /proc/sys/kernel/hostname                                               r,

    owner /proc/@{pid}/fd/                                                  r,
    owner /proc/@{pid}/fdinfo/@{tid}                                        r,
    owner /proc/@{pid}/{mountinfo,stat}                                     r,

    owner @{CONFIG}/QtProject.conf                                          r,

    owner @{HOME}/Desktop{,/}                                               r,
    owner @{HOME}/Documents{,/}                                             r,
    owner @{HOME}/@{XDG_DESKTOP_DIR}{,/}                                    r,
    owner @{HOME}/@{XDG_DOCUMENTS_DIR}{,/}                                  r,
    owner @{HOME}/.temp.workdrive.f{ile,older}.*.*{,/}                      r,

    owner /proc/@{pid}/oom_score_adj                                        rw,

    owner /dev/shm/.org.chromium.Chromium.*                                 rwk,

    owner @{HOME}/.local/apps/zohoworkdrive/{,**}                           rm,

    owner @{HOME}/.zohoworkdrive/**                                         rwk,
    owner @{HOME}/.pki/nssdb/*.{db,txt}                                     rwk,
    owner @{HOME}/.local/apps/agent.conf                                    rw,
    owner @{HOME}/.config/workdrive/{,**}                                   rwk,
    owner @{HOME}/.local/lib/pki/nssdb/*.{db,txt}                           rwk,
    owner @{HOME}/.local/apps/zohoworkdrive/zlock                           rwk,
    owner @{HOME}/.local/apps/zohoworkdrive/sync.*                          rwk,
    owner @{HOME}/.local/apps/zohoworkdrive/logs/{,*}                       rw,
    owner @{HOME}/.local/apps/zohoworkdrive/locales{,/}                     rw,
    owner @{HOME}/.local/apps/zohoworkdrive/backup/{,**}                    rwk,
    owner @{HOME}/Documents/Zoho\ WorkDrive\ \(*\)/{,**}                    rwk,
    owner @{HOME}/.local/apps/zohoworkdrive/config.dat{,-*}                 rwk,
    owner @{HOME}/.local/apps/zohoworkdrive/resources.db{,-*}               rwk,
    owner @{HOME}/.local/apps/zohoworkdrive/office_doc_statsdb              rwk,
    owner @{HOME}/@{XDG_DESKTOP_DIR}/Zoho\ WorkDrive\ \(*\){,**}            rwk,
    owner @{HOME}/Documents/.temp.workdrive.f{ile,older}.*.*{,/}            rw,
    owner @{HOME}/.local/apps/zohoworkdrive/service_info.dat{,-*}           rwk,
    owner @{HOME}/@{XDG_DOCUMENTS_DIR}/Zoho\ WorkDrive\ \(*\){,**}          rwk,
    owner @{HOME}/@{XDG_DESKTOP_DIR}/.temp.workdrive.f{ile,older}.*.*{,/}   rw,
    owner @{HOME}/@{XDG_DOCUMENTS_DIR}/.temp.workdrive.f{ile,older}.*.*{,/} rw,

    # NOTE(dij): Did some debugging, apparently these are called to grab some
    #            info about the process itself and the environment (mostly disk data).
    #            This app ships with an entire Python backend with Qt, not sure
    #            why they're just parsing the output of shell commands to get instead
    #            of using syscalls.
    #            The gcc and ld seem to be here to pre-compile some of the Python
    #            code on the fly.
    /usr/bin/df                                                             ix, # df -T
    /usr/bin/cat                                                            ix,
    /usr/bin/gcc                                                            ix,
    /usr/bin/dash                                                           ix, # Only needed for launching main
    /usr/bin/bus-send                                                       ix,
    /usr/bin/hostname                                                       ix,
    /usr/bin/xdg-open                                                       Pix -> xdg-open,
    /usr/bin/ld{,config}                                                    ix, # ldconfig -p

    owner @{HOME}/.local/apps/zohoworkdrive/zohoworkdrived                  ix,
    owner @{HOME}/.local/apps/zohoworkdrive/QtWebEngineProcess              ix,

    deny @{HOME}/.__main__.py{,/}                                           rw,
    deny @{CONFIG}/QtProject.conf                                           w,
    deny @{HOME_DATA}/bookmarks.conf                                        w,
    deny @{HOME}/.QtWebEngineProcess{,/}                                    rw,

    # WorkDrive doesn't need to open things.
    deny /usr/bin/cut                                                       x,
    deny /usr/bin/file                                                      x,
    deny /usr/bin/pmap                                                      x,
    deny /usr/bin/tail                                                      x,
    deny /usr/bin/xprop                                                     x,
    deny /usr/bin/uname                                                     x,
    deny /usr/bin/realpath                                                  x,

    # Notify us when it tries to upgrade as it will fill the drive.
    audit deny @{HOME}/.local/apps/zohoworkdrive/upgrade{,/,/**}            rw,

    include if exists <local/local.apps.workdrived>
}
