include <tunables/spaceport>

profile atlauncher @{HOME}/{,.dotfiles/}.local/bin/tools/atlauncher flags=(enforce) {
    include <abstractions/gtk>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/video>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/ssl_certs>
    include <abstractions/user-home>
    include <abstractions/nameservice>
    include <abstractions/freedesktop.org>

    network                                                   inet  stream,
    network                                                   inet6 stream,

    /usr/lib/                                                 r,
    /etc/fstab                                                r,
    /usr/bin/dash                                             rm,
    /etc/modprobe.d/                                          r,
    /etc/udev/hwdb.bin                                        r,
    /usr/share/java/*.jar                                     r,
    /usr/share/hwdata/pci.ids                                 r,
    /etc/ssl/certs/java/cacerts                               r,
    /etc/java-[0-9]*-openjdk/**                               r,
    /etc/java-openjdk/net.properties                          r,
    /etc/java-openjdk/jaxp.properties                         r,
    /etc/java-openjdk/logging.properties                      r,
    /etc/java-openjdk/security/java.security                  r,
    /etc/java-openjdk/security/policy/unlimited/              r,
    /etc/java-openjdk/security/policy/**/*.policy             r,
    /usr/lib/jvm/java-[0-9]*-openjdk-*/lib/server/classes.jsa rm,

    /sys/bus/pci/**                                           r,
    /sys/{bu,clas}s/                                          r,
    /sys/fs/cgroup/{,**}                                      r,
    /sys/bus/cpu/devices/                                     r,
    /sys/module/compression                                   r,
    /sys/kernel/mm/hugepages/                                 r,
    /sys/devices/system/node/                                 r,
    /sys/devices/system/cpu/cpu*/                             r,
    /sys/devices/system/cpu/cpu*/uevent                       r,
    /sys/devices/virtual/dmi/id/bios_vendor                   r,
    /sys/devices/system/cpu/cpu*/topology/*                   r,
    /sys/devices/system/cpu/cpu*/cache/{,**}                  r,
    /sys/devices/system/cpu/vulnerabilities/                  r,
    /sys/devices/system/cpu/{kernel_max,present}              r,
    /sys/devices/system/cpu/cpu0/microcode/version            r,
    /sys/devices/system/cpu/cpufreq/policy*/*_freq            r,
    /sys/kernel/mm/transparent_hugepage/{,shmem_}enabled      r,

    /proc/                                                    r,
    /proc/bus/pci/devices                                     r,
    /proc/c{groups,mdline}                                    r,
    /proc/{version,uptime}                                    r,
    /proc/sys/kernel/osrelease                                r,
    /proc/sys/net/core/somaxconn                              r,
    /proc/sys/net/ipv4/tcp_fastopen                           r,
    /proc/@{pid}/net/i{f_inet6,pv6_route}                     r,
    /proc/sys/net/ipv6/conf/all/disable_ipv6                  r,

    /tmp/                                                     r,

    owner @{CGROUP}/app.slice/cpu.max                         r,
    owner @{CGROUP}/app.slice/sway.service/memory.{high,max}  r,

    owner /proc/@{pid}/fd/                                    r,
    owner /proc/@{pid}/stat                                   r,
    owner /proc/@{pid}/mount{s,info}                          r,
    owner /proc/@{pid}/c{group,mdline}                        r,

    owner @{HOME}/                                            r,
    # This is for AtLauncher to download files manually.
    owner @{HOME}/Downloads/*.jar                             r,
    owner @{HOME}/.config/java/jssc/linux/*.so                rm,

    owner /proc/@{pid}/coredump_filter                        rw,
    owner /proc/@{pid}/task/@{tid}/comm                       rw,

    owner /tmp/*.tmp                                          rw,
    owner /{tmp,var/run}/hsperfdata_*/                        rw,
    owner /{tmp,var/run}/hsperfdata_*/@{pid}                  rwk,

    owner @{CACHE}/JNA/**                               rmwkl,
    owner @{HOME}/.java/fonts/*/                              rw,
    owner @{HOME}/.config/java/fonts/*/                       rw,
    owner @{HOME}/Documents/Minecraft/**                      rmwkl,
    owner @{HOME}/Documents/Minecraft/**/bin/*                rwix,
    owner @{HOME}/.java/fonts/*/fcinfo[0-9]*.tmp              rw,
    owner @{HOME}/.java/fonts/*/fcinfo-*.properties           rw,
    owner @{HOME}/.config/java/fonts/*/fcinfo[0-9]*.tmp       rw,
    owner @{HOME}/Documents/Minecraft/**/lib/jspawnhelper     rwix,
    owner @{HOME}/.config/java/fonts/*/fcinfo-*.properties    rw,

    /usr/bin/uname                                            ix,
    /usr/bin/ldconfig                                         ix,
    /usr/bin/xdg-open                                         Pix -> xdg-open,
    /usr/bin/ls{cpu,pci}                                      ix,
    /usr/lib/gio-launch-desktop                               Pix -> xdg-open,
    /usr/lib/jvm/default{,-runtime}/{,jre/}bin/java           ix,
    /usr/lib/jvm/java-[0-9]*-openjdk/{,jre/}bin/java          ix,
    /usr/lib/jvm/java-[0-9]*-openjdk/lib/jspawnhelper         ix,
    /usr/lib/jvm/java-[0-9]*-openjdk-*/{,jre/}bin/java        ix,
    /usr/lib/jvm/java-[0-9]*-openjdk-*/lib/jspawnhelper       ix,

    deny ptrace read peer=xdg-{open,settings},

    include if exists <local/local.bin.atlauncher>
}
