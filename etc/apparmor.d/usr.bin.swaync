include <tunables/spaceport>

profile swaync /usr/bin/swaync flags=(enforce) {
    include <abstractions/dri>
    include <abstractions/gtk>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/opengl>
    include <abstractions/vulkan>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/glycin-base>
    include <abstractions/nameservice>
    include <abstractions/notifications>
    include <abstractions/private-files>

    @{sysconfig}/usr/lib/smd/bin/powerctl             Px -> powerctl,

    /etc/machine-id                                   r,
    /usr/bin/swaync                                   rm,
    /etc/xdg/swaync/*                                 r,
    /usr/share/glib-2.0/schemas/gschemas.compiled     r,

    /sys/devices/pci*/**/uevent                       r,
    /sys/class/backlight/*/{,max_}brightness          r,
    /sys/devices/pci*/**/*backlight/{,max_}brightness r,

    owner /proc/@{pid}/cmdline                        r,

    owner @{CONFIG}/mimeapps.list                     r,
    owner @{CONFIG}/swaync/style.css                  r,
    owner @{CONFIG}/swaync/config.json                r,

    owner @{HOME}/                                    r,
    owner @{HOME}/Pictures/Screenshots/*.@{IMAGES}    r,

    /usr/bin/sudo                                     Px -> sudo,
    /usr/bin/wlay                                     Px -> wlay,
    /usr/local/bin/*ctl                               Px -> powerctl,
    /usr/bin/{,ba,da}sh                               ix,
    /usr/bin/swaync-client                            Px -> swaync-client,
    /usr/lib/smd/bin/powerctl                         Px -> powerctl,

    owner @{HOMEDOTS}/.local/bin/{,sway/}*            PUx,

    dbus bind name=org.erikreider.swaync.cc,

    dbus (send, receive) interface=org.erikreider.swaync.cc,

    include if exists <local/usr.bin.swaync>
}
