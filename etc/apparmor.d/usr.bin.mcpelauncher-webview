include <tunables/spaceport>

profile mcpelauncher-webview /usr/bin/mcpelauncher-webview flags=(complain) {
    include <abstractions/qt>
    include <abstractions/chromium>
    include <abstractions/private-files>

    network                             inet  stream,
    network                             inet6 stream,

    /usr/bin/                           r,
    /usr/bin/mcpelauncher-webview       r,

    /sys/{bu,clas}s/                    r,

    owner @{CACHE_TEMP}/minecraft/{,**} rwl,

    /usr/lib/qt*/QtWebEngineProcess     ix,

    deny @{CONFIG}/mozilla{,/**}        r,
    deny @{CONFIG}/chromium{,/**}       r,

    include if exists <local/usr.bin.mcpelauncher-webview>
}
