include <tunables/spaceport>

profile mcpelauncher /usr/bin/mcpelauncher-ui-qt flags=(enforce, attach_disconnected, mediate_deleted) {
    include <abstractions/qt>
    include <abstractions/mesa>
    include <abstractions/audio>
    include <abstractions/dconf>
    include <abstractions/video>
    include <abstractions/vulkan>
    include <abstractions/ssl_certs>
    include <abstractions/glycin-base>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    network                                                inet  stream,
    network                                                inet6 stream,

    /**                                                    kl, # This is here to allow for in-memory blob locking

    /etc/machine-id                                        r,
    /usr/share/mcpelauncher/**                             rm,
    /usr/bin/mcpelauncher-ui-qt                            rm,

    /dev/input/                                            r,
    /dev/input/event*                                      r,

    owner @{HOME}/{,Downloads/}*                           r,

    owner @{CACHE}/Minecraft\ Linux\ Launcher/**           l,
    owner @{CACHE}/Minecraft\ Linux\ Launcher{,/**}        rw,

    owner @{CACHE_TEMP}/minecraft/**                       l,
    owner @{CACHE_TEMP}/minecraft{,/**}                    rw,

    owner @{HOME}/.local/share/mcpelauncher{,/**}          rwk,
    owner @{HOME}/.config/Minecraft\ Linux\ Launcher/**    l,
    owner @{HOME}/.local/share/mcpelauncher/versions/*/**  rw,
    owner @{HOME}/.config/Minecraft\ Linux\ Launcher{,/**} rwk,

    /usr/bin/xdg-open                                      Px -> xdg-open,
    /usr/bin/mcpelauncher-client                           Pxr -> mcpelauncher-client,
    /usr/bin/mcpelauncher-extract                          ix,

    include if exists <local/usr.bin.mcpelauncher-ui-qt>
}
