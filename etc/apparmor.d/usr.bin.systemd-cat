include <tunables/spaceport>

profile systemd-cat /usr/bin/systemd-cat flags=(enforce) {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/private-files>

    capability net_admin,

    /usr/bin/systemd-cat  rm,

    /                     r,
    /usr/                 r,
    /usr/bin/             r,
    /usr/local/{,s}bin/   r,

    /usr/bin/**           PUx,
    /usr/local/{,s}bin/** PUx,

    include if exists <local/usr.bin.systemd-cat>
}
