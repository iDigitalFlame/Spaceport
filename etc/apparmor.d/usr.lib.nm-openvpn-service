include <tunables/spaceport>

profile nm-openvpn-service /usr/lib/nm-openvpn-service flags=(enforce) {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/nameservice>

    capability                                 kill,
    capability                                 dac_override,
    capability                                 net_admin,

    signal send set=(term) peer=openvpn,

    /usr/lib/nm-openvpn-service                rm,

    owner /proc/@{pid}/fd/                     r,

    @{HOME}/.cert/nm-openvpn/*.pem             r,
    @{HOME}/.config/openvpn/nm-openvpn/*.pem   r,

    /dev/net/tun                               rw,

    @{run}/NetworkManager/nm-openvpn-*         rw,

    /usr/bin/kmod                              Px -> kmod,
    /usr/bin/openvpn                           Px -> openvpn,
    /usr/bin/{,ba,da,z}sh                      ix,
    /usr/lib/nm-openvpn-auth-dialog            Px -> nm-openvpn-auth-dialog,
    /usr/lib/nm-openvpn-service-openvpn-helper Px -> nm-openvpn-auth-dialog,

    include if exists <local/usr.lib.nm-openvpn-service>
}
