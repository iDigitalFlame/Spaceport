abi <abi/4.0>,

# user-home details:
#   Setup for typical application permissions. Allow usage of $HOME and
#   subdirectories, but prevent access to "hidden" (dot-style) directories
#   and files. Profiles that use this should setup explicit permissions
#   for the application's configuration and cache directories.
#
#   Standard directory access (thumbnails, themes, etc.) are handled by
#   their respective abstractions.

include <abstractions/private-files>

owner /tmp/*                            r,

owner @{HOME}/                          r,

# Allow X/Wayland dot-files
owner @{HOME_DATA}/.dmrc                r,
owner @{HOME_DATA}/.Xdefaults           r,
owner @{HOME_DATA}/.Xresources          r,

owner @{MOUNTS}/{,**}                   r,

owner @{HOME}/*                         rw,
owner @{HOME}/Downloads{,/**}           rw,
owner @{HOME}/@{XDG_DOWNLOAD_DIR}{,/**} rw,

owner /mnt/{,**}                        rw,
owner /media/{,**}                      rw,

deny @{HOME}/.*                         rw,
deny @{HOME}/Desktop/.*                 rw,
deny @{HOME}/Downloads/.*               rw,
deny @{HOME}/@{XDG_DESKTOP_DIR}/.*      rw,
deny @{HOME}/@{XDG_DOWNLOAD_DIR}/.*     rw,

deny @{HOME_DATA}/.zshenv               rw,

# Allow subdirectories of non dot-files
owner @{HOME}/[^.]*{,/,**}              rw,

include if exists <abstractions/user-home.d>
