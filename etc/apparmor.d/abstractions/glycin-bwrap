abi <abi/4.0>,

include <abstractions/base>
include <abstractions/fonts>
include <abstractions/private-files>

capability                                     setpcap,
capability                                     net_admin,
capability                                     sys_admin,
capability                                     sys_ptrace,

network                                        netlink raw,

signal receive set=(int, kill, quit, term),

/                                              r,
/usr/bin/bwrap                                 r,
/usr/share/glycin-loaders/2+/conf.d{/,/*.conf} r,

/proc/sys/kernel/overflow{g,u}id               r,
/proc/sys/user/max_user_namespaces             r,
/proc/sys/kernel/seccomp/actions_avail         r,

owner /proc/@{pid}/fd/                         r,
owner /proc/@{pid}/mountinfo                   r,

owner @{HOME}/.cache/thumbnails/**             r,

/tmp/{new,old}root{,/}                         rw,

owner /proc/@{pid}/setgroups                   rw,
owner /proc/@{pid}/{g,u}id_map                 rw,

owner /newroot/{,**}                           w,

/{usr/,}bin/true                               ix,
/usr/lib/glycin-loaders/2+/glycin-*            ix,

mount               options=(rw rbind)                         -> /newroot/{,**},
mount               options=(rw rbind)           /tmp/newroot/ -> /tmp/newroot/,
mount fstype=tmpfs  options=(rw nosuid nodev)            tmpfs -> /newroot/{,**},
mount fstype=tmpfs  options=(rw nosuid nodev)            tmpfs -> /tmp/,
mount fstype=devpts options=(rw nosuid noexec)          devpts -> /newroot/dev/pts/,
mount               options=(rw silent rslave)                 -> /,
mount               options=(rw silent rprivate)               -> /oldroot/,

umount /,
umount /{new,old}root/,

remount /newroot/{,**},

pivot_root oldroot=/newroot/     /newroot/,
pivot_root oldroot=/tmp/oldroot/ /tmp/,
