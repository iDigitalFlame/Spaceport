# Allow confined processes to signal they are shutting down to smd-client
# and smd-daemon.
signal receive peer=smd-{client,daemon} set=(cont, int, kill, quit, term, stop),
signal receive peer=unconfined          set=(cont, hup, int, kill, pipe, quit, segv, stop, term),
signal receive peer=shell               set=(cont, hup, int, kill, quit, term, stop),
signal         peer=@{profile_name},

@{sysconfig}/etc/ld.so.preload                 r,

/etc/timezone                                  r,
/etc/gnutls/config                             r,
/etc/ld.so.preload                             r,

/var/cache/ld.so.cache                         rm,

audit deny /opt/secureboot/{,*}                rw,

deny /apparmor/.null                           rw, # Disconnected Paths

deny /etc/ld.so.preload                        w,
deny @{sysconfig}/etc/ld.so.preload            w,

deny @{HOME}/.recently-used.xbel{,*}           w,
deny @{HOME}/.local/share/recently-used.xbel   w,
deny @{HOME}/.local/share/recently-used.xbel.* w,

deny signal send peer=unconfined,
