deny /opt/hydra/*/{,**}                                                   mrwkl,

deny @{HOME}/.config/                                                     w,
deny @{HOME}/Machines/{,**}                                               mrwkl,
deny @{HOME}/.config/smd.json                                             mrwkl,
deny @{HOME}/.local/lib/zshrc.sh                                          mrwkl,
deny @{HOME}/.config/openvpn/{,**}                                        mrwkl,

# Get alerts on file acccess to weird areas
audit deny @{run}/user/@{uid}/gcr{,**}                                    mrwkl,
audit deny @{run}/user/@{uid}/keyring{,**}                                mrwkl,

audit deny @{CONFIG}/zsh/*                                                wl,
audit deny @{CONFIG}/.zshenv                                              wl,

audit deny @{CACHE}/wget-hsts                                             mrwkl,
audit deny @{CACHE}/zsh/{,**}                                             mrwkl,

audit deny @{HOME}/.zshenv                                                wl,
audit deny @{HOME}/.ssh/{,**}                                             mrwkl,
audit deny @{HOME}/.cert/{,**}                                            mrwkl,
audit deny @{HOME}/.local/.ssh/{,**}                                      mrwkl,
audit deny @{HOME}/.config/Yubico{,/**}                                   mrwkl,
audit deny @{HOME}/.config/openvpn/{,**}                                  mrwkl,
audit deny @{HOME}/.local/share/gnupg/{,**}                               mrwkl,

audit deny @{HOMEDATA}/.local/bin/{,**}                                   wl,
audit deny @{HOMEDATA}/.local/share/applications/{,**}                    wl,
audit deny @{HOMEDATA}/.local/share/applications/mimeinfo.cache           w,
audit deny @{HOMEDATA}/.local/share/applications/{defaults,mimeapps}.list w,
