owner @{run}/user/@{uid}/gnupg/.gpg-*                 r,
owner @{run}/user/@{uid}/gnupg/*.conf                 r,

owner @{GPG_DIR}/.gpg-*                               r,
owner @{GPG_DIR}/*.conf                               r,
owner @{GPG_DIR}/options                              r,
owner @{GPG_DIR}/so/*.x86_64                          rm,

owner @{run}/user/@{uid}/gnupg/                       rw,
owner @{run}/user/@{uid}/gnupg/.#lk*                  rw,
owner @{run}/user/@{uid}/gnupg/sshcontrol             rw,
