owner @{GPG_DIR}/                                     rw,
owner @{GPG_DIR}/.#lk*                                rwkl,
owner @{GPG_DIR}/sshcontrol                           rw,
owner @{GPG_DIR}/crls.d/{,*}                          rw,
owner @{GPG_DIR}/random_seed                          rw,
owner @{GPG_DIR}/{,d.*/}{,S.*}                        rw,
