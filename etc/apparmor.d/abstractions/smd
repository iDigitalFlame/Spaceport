abi <abi/4.0>,

include <abstractions/base>
include <abstractions/python>
include <abstractions/consoles>
include <abstractions/nameservice>

capability                                        dac_override,
capability                                        dac_read_search,

@{sysconfig}/usr/lib/smd/{,s}bin{,/*}             r,
@{sysconfig}/usr/lib/smd/lib{,exec}{,/**}         r,
@{sysconfig}/var/cache/smd/constants.json         r,

@{sysconfig}/usr/lib/smd/lib/smd-message          ixr,

/usr/bin/                                         r,
/usr/lib/smd/{,s}bin{,/*}                         r,
/usr/lib/smd/lib{,exec}{,/**}                     r,
/var/cache/smd/constants.json                     r,

/dev/null                                         r,

/proc/                                            r,

owner /proc/@{pid}/stat                           r,
owner /proc/@{pid}/cmdline                        r,

owner @{CONFIG}/smd.json                          r,

@{run}/smd/*.sock                                 rw,

/usr/lib/smd/lib/smd-message                      ixr,

unix (connect, receive, send) type=stream peer=(addr="@{run}/smd/*.sock"),

deny /usr/lib/smd/**/__pycache__/*.pyc{,*}        w,

include if exists <abstractions/smd.d>
