include <tunables/spaceport>

profile swtpm /usr/bin/swtpm flags=(enforce) {
    include <abstractions/command>
    include <abstractions/nameservice>

    capability                                    fsetid,
    capability                                    fowner,
    capability                                    sys_admin,
    capability                                    dac_override,
    capability                                    dac_read_search,

    signal receive set=(cont, int, stop, term) peer=smd-daemon,

    /usr/bin/swtpm                                rm,
    /**/*.{bin,disk,fd,img,iso,ram,raw}           rk,

    /opt/hydra/**/*.{bin,disk,fd,img,iso,ram,raw} rwk,

    @{run}/smd/hydra/*.swtpm{,.pid}               rw,

    unix (bind, listen) type=stream addr="@/tmp/dbus-*",

    unix (accept, receive, send) type=stream addr="@/tmp/dbus-*",

    include if exists <local/usr.bin.swtpm>
}
