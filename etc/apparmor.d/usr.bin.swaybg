include <tunables/spaceport>

profile swaybg /usr/bin/swaybg flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/mime>
    include <abstractions/glycin>
    include <abstractions/wayland>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    signal receive set=(int, kill, quit, term),

    /usr/bin/swaybg              rm,

    owner @{HOME}/**/*.@{IMAGES} r, # For pictures and backgrounds.

    /dev/shm/swaybg-*            rw,

    /usr/bin/bwrap               Cx -> glycin,

    profile glycin flags=(enforce, attach_disconnected) {
        include <abstractions/glycin-bwrap>

        owner @{HOME}/**/*.@{IMAGES} r,
    }

    include if exists <local/usr.bin.swaybg>
}
