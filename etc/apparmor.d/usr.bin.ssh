include <tunables/spaceport>

profile ssh /usr/bin/ssh flags=(enforce) {
    include <abstractions/base>
    include <abstractions/openssl>
    include <abstractions/consoles>
    include <abstractions/nameservice>
    include <abstractions/private-files>
    include <abstractions/dbus-session-strict>

    network                                    inet    stream,
    network                                    inet6   stream,
    network                                    netlink raw,

    signal receive set=(term) peer=gnome-keyring-daemon,
    signal receive set=(hup, int, kill, term),

    @{sysconfig}/etc/ssh/ssh_config            r,

    /etc/ssh/ssh_config                        r,
    /etc/ssh/ssh_config.d/{,*}                 r,

    owner /etc/smd/*                           r,

    owner /proc/@{pid}/fd/                     r,
    owner /proc/@{pid}/loginuid                r,

    owner @{HOME}/.local/ssh/{,*}              r,
    owner @{HOME}/.config/ssh/{,*}             r,

    owner @{run}/user/@{uid}/keyring/ssh       rw,

    owner /tmp/ssh-*/{,agent.*}                rwkl,

    owner @{HOME}/.config/ssh/known_hosts{,.*} rwl,

    /usr/bin/ssh                               ixrm,
    /usr/bin/{,ba,da,rba,z}sh                  ix,

    include if exists <local/usr.bin.ssh>
}
