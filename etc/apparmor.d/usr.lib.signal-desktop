include <tunables/spaceport>

profile signal-desktop /usr/{bin,lib}/signal-desktop/signal-desktop flags=(enforce, attach_disconnected) {
    include <abstractions/video>
    include <abstractions/cgroup>
    include <abstractions/chromium>
    include <abstractions/user-home>
    include <abstractions/notifications>
    include <abstractions/dbus-network-manager-strict>

    ptrace read  peer=/usr/bin/xdg-{open,settions},
    ptrace trace peer=/usr/lib/signal-desktop/chrome-sandbox,

    /usr/lib/signal-desktop/**                       r,
    /usr/lib/signal-desktop/resources/**             rm,

    /sys/{bus,class}/                                r,
    /sys/bus/pci/devices                             r,

    owner @{HOME}/                                   r,

    @{run}/systemd/inhibit/*.ref                     rw,

    owner @{HOME}/.config/Signal/{,**}               rwkl,

    /usr/bin/xdg-open                                Pix -> xdg-open,
    /usr/bin/xdg-email                               Pix -> xdg-email,
    /usr/lib/signal-desktop/signal-desktop           ixr,
    /usr/lib/signal-desktop/electron*/chrome-sandbox ix,

    deny /usr/bin/xdg-settings                       rx,

    deny ptrace read peer=firefox,
    deny ptrace read peer=unconfined,

    include if exists <local/usr.lib.signal-desktop>
}
