include <tunables/spaceport>

profile fusermount /usr/bin/fusermount{,*} flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                    sys_admin,
    capability                    dac_read_search,

    /etc/fuse{,*}.conf            r,
    /usr/bin/fusermount{,*}       rm,

    /proc/@{pid}/mounts           r,

    /dev/fuse                     rw,
    /dev/tty*                     rw,

    owner @{run}/user/@{uid}/doc/ rw,

    mount options=(rw, rprivate)                  -> /,
    mount options=(rw, rbind) @{run}/user/@{uid}/ -> /,
    mount fstype=fuse.portal                      -> @{run}/user/@{uid}/doc/,

    umount @{run}/user/@{uid}/doc/,

    unix (send receive) type=stream peer=(label=xdg-document-portal),

    include if exists <local/usr.bin.fusermount>
}
