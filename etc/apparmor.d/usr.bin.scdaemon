include <tunables/spaceport>

profile scdaemon /usr/{bin,lib}/{,gnupg/}scdaemon flags=(enforce) {
    include <abstractions/base>
    include <abstractions/nameservice>

    network                                          netlink raw,

    signal send          peer=gpg-agent,
    signal send set=usr2 peer=unconfined,

    /usr/{bin,lib}/{,gnupg/}scdaemon                 rm,

    /dev/                                            r,
    /dev/bus/usb/{,*/}                               r,

    /sys/{bu,clas}s/                                 r,
    /sys/bus/usb/{,usbmisc/}                         r,
    /sys/bus/usb/devices/{,**}                       r,
    /sys/devices/pci*/**/bConfigurationValue         r,

    @{run}/udev/data/+usb:*                          r,
    @{run}/udev/data/c1{6,8}*:*                      r,

    owner /etc/pacman.d/gnupg/scdaemon.conf          r,
    owner /var/db/pacman/gnupg/scdaemon.conf         r,

    owner @{HOME}/.gpnpg/common.conf                 r,
    owner @{HOME}/.gpnpg/scdaemon.conf               r,
    owner @{HOME}/.local/share/gpnpg/common.conf     r,
    owner @{HOME}/.local/share/gpnpg/scdaemon.conf   r,

    /dev/bus/usb/*/*                                 rwk,

    /sys/devices/**/usb*/{,**}                       rw,

    /proc/@{pid}/task/@{tid}/comm                    rw,

    owner @{run}/user/@{uid}/gnupg/{,d.*/}S.scdaemon rw,

    owner @{HOME}/.local/share/gpnpg{,/}             rw,
    owner @{HOME}/.gpnpg/reader_*.status             rw,
    owner @{HOME}/.local/share/gpnpg/reader_*.status rw,

    include if exists <local/usr.bin.scdaemon>
}
