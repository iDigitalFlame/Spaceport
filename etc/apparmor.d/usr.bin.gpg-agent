include <tunables/spaceport>

profile gpg-agent /usr/bin/gpg-agent flags=(enforce) {
    include <abstractions/base>
    include <abstractions/gnupg>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/nameservice>

    signal receive peer=scdaemon,
    signal receive peer=pinentry{,-*},

    /usr/bin/gpg-agent                               rm,
    /usr/share/gnupg/*                               r,

    /proc/@{pid}/fd/                                 r,

    owner @{GPG_DIR_SYS}/.gpg-*                      r,
    owner @{GPG_DIR_SYS}/*.conf                      r,

    owner @{GPG_DIR_SYS}/                            rw,
    owner @{GPG_DIR_SYS}/.#lk*                       rwkl,
    owner @{GPG_DIR_SYS}/sshcontrol                  rw,
    owner @{GPG_DIR_SYS}/crls.d/{,*}                 rw,
    owner @{GPG_DIR_SYS}/{,d.*/}{,S.*}               rw,
    owner @{GPG_DIR_SYS}/openpgp-revocs.d/{,*}       rw,
    owner @{GPG_DIR_SYS}/private-keys-v1.d/{,*}      rw,
    owner @{GPG_DIR_SYS}/*.{db,kbx,kbx~,gpg}{,.lock} rwkl,

    /usr/bin/pinentry{,-*}                           Px,
    /usr/{bin,lib}/{,gnupg/}scdaemon                 Px -> scdaemon,

    include if exists <local/usr.bin.gpg-agent>
}
