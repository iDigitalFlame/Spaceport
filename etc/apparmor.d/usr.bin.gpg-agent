include <tunables/spaceport>

profile gpg-agent /usr/bin/gpg-agent flags=(enforce) {
    include <abstractions/base>
    include <abstractions/gnupg>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/nameservice>

    signal receive peer=scdaemon,
    signal receive peer=pinentry{,-*},

    /usr/share/gnupg/*                                    r,
    /usr/bin/gpg-agent                                    rm,

    /proc/@{pid}/fd/                                      r,

    owner @{GPG_SYS_DIR}/.gpg-*                           r,
    owner @{GPG_SYS_DIR}/*.conf                           r,

    owner @{GPG_SYS_DIR}/                                 rw,
    owner @{GPG_SYS_DIR}/.#lk*                            rwkl,
    owner @{GPG_SYS_DIR}/sshcontrol                       rw,
    owner @{GPG_SYS_DIR}/crls.d/{,*}                      rw,
    owner @{GPG_SYS_DIR}/{,d.*/}{,S.*}                    rw,
    owner @{GPG_SYS_DIR}/openpgp-revocs.d/{,*}            rw,
    owner @{GPG_SYS_DIR}/private-keys-v1.d/{,*}           rw,
    owner @{GPG_SYS_DIR}/*.{db,kbx,kbx~,gpg}{,.lock}      rwkl,

    /usr/bin/pinentry{,-*}                                Px,
    /usr/{bin,lib}/{,gnupg/}scdaemon                      Px -> scdaemon,

    include if exists <local/usr.bin.gpg-agent>
}
