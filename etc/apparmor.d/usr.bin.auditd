include <tunables/spaceport>

profile auditd /usr/bin/auditd flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                       chown,
    capability                       fsetid,
    capability                       sys_nice,
    capability                       sys_resource,
    capability                       audit_control,

    network                          netlink raw,

    @{sysconfig}/etc/audit/{,**}     r,

    /usr/bin/auditd                  rm,
    /etc/machine-id                  r,
    /etc/audit/{,**}                 r,

    /proc/@{pid}/                    r,

    owner /proc/@{pid}/loginuid      r,
    owner /proc/@{pid}/sessionid     r,
    owner /proc/@{pid}/attr/current  r,

    /var/log/audit{,/,/**}           rw,

    @{run}/audit{,/}                 rw,
    @{run}/log/audit{,/}             rw,
    @{run}/log/audit/audit.*         rw,
    @{run}/{,audit}/auditd.pid       rwl,
    @{run}/{,audit}/auditd.state     rw,

    owner /proc/@{pid}/oom_score_adj rw,

    deny /etc/audit/{,**}            w,

    include if exists <local/usr.bin.auditd>
}
