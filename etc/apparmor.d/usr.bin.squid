include <tunables/spaceport>

profile squid /usr/bin/squid flags=(enforce) {
    include <abstractions/base>
    include <abstractions/mime>
    include <abstractions/ssl_certs>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                    setgid,
    capability                                    setuid,

    network                                       inet  stream,
    network                                       inet6 stream,

    @{sysconfig}/etc/squid/*.conf                 r,

    /                                             r,
    /etc/                                         r,
    /usr/share/squid{,/,/**}                      r,
    /etc/squid/*.c{ss,onf}{,.default,.documented} r,

    /sys/bus/media/devices/                       r,
    /sys/devices/pci*/uevent                      r,

    /proc/sys/kernel/ngroups_max                  r,
    /proc/sys/kernel/random/boot_id               r,

    @{run}/                                       r,
    @{run}/systemd/userdb/                        r,

    @{run}/squid.pid                              rwk,

    owner /dev/shm/squid-*                        rw,

    owner /tmp/squid/**                           rw,
    owner /tmp/squid{,/}                          rw,

    /usr/bin/squid                                ix,
    /usr/lib/squid/*                              ix,

    include if exists <local/usr.bin.squid>
}
