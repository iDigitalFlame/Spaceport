include <tunables/spaceport>

profile dirmngr /usr/bin/dirmngr flags=(enforce) {
    include <abstractions/base>
    include <abstractions/p11-kit>
    include <abstractions/consoles>
    include <abstractions/ssl_certs>
    include <abstractions/nameservice>

    network                                       inet  dgram,
    network                                       inet6 dgram,
    network                                       inet  stream,
    network                                       inet6 stream,

    /usr/bin/dirmngr                              rm,
    /usr/share/gnupg/*.pem                        r,

    owner @{GPG_SYS_DIR}/dirmngr.conf             r,
    owner @{GPG_SYS_DIR}/dirmngr_ldapservers.conf r,

    owner @{GPG_DIR}/dirmngr.conf                 r,
    owner @{GPG_DIR}/dirmngr_ldapservers.conf     r,

    owner @{GPG_SYS_DIR}/                         rw,
    owner @{GPG_SYS_DIR}/crls.d/{,*}              rw,
    owner @{GPG_SYS_DIR}/crls.d/DIR.txt           rw,
    owner @{GPG_SYS_DIR}/{,d.*/}{,S.dirmngr}      rw,

    owner /proc/@{pid}/task/@{tid}/comm           rw,

    owner @{run}/user/@{uid}/gnupg/               rw,
    owner @{run}/user/@{uid}/gnupg/{,d.*/}{,S.*}  rw,

    owner @{GPG_DIR}/                             rw,
    owner @{GPG_DIR}/crls.d/{,*}                  rw,
    owner @{GPG_DIR}/crls.d/DIR.txt               rw,
    owner @{GPG_DIR}/{,d.*/}{,S.dirmngr}          rw,

    include if exists <local/usr.bin.dirmngr>
}
