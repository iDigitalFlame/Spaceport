include <tunables/spaceport>

profile xdg-email /usr/bin/xdg-email flags=(enforce) {
    include <abstractions/base>
    include <abstractions/mime>
    include <abstractions/xdg-open>
    include <abstractions/no-network>
    include <abstractions/xdg-desktop>
    include <abstractions/private-files>

    @{sysconfig}/bin/ghr                                   Pix -> ghr,
    @{sysconfig}/bin/hostname                              ixr,

    /usr/bin/xdg-email                                     r,

    /proc/version                                          r,
    /proc/sys/kernel/hostname                              r,

    owner @{CONFIG}/mimeapps.list                          r,

    /usr/bin/dbus-send                                     ix,
    /usr/bin/{u,base,host}name                             ix,
    /usr/bin/{cat,env,file,gawk,realpath,printf,xprop}     ix,

    /usr/bin/ghr                                           Px -> ghr,
    /usr/bin/xdg-open                                      Px -> xdg-open,
    /usr/bin/chrom{e,ium}                                  Px,
    /usr/{bin,lib/signal-desktop}/signal-desktop           Px,
    /usr/{bin,lib}/{firefox,librewolf}/{firefox,librewolf} Px,

    owner @{HOMEDATA}/.local/bin/**                        PUx,

    include if exists <local/usr.bin.xdg-email>
}
