include <tunables/spaceport>

profile systemd-hwdb /usr/{bin,lib/systemd}/systemd-hwdb flags=(attach_disconnected, enforce, mediate_deleted) {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/no-network>
    include <abstractions/private-files>

    capability                          dac_override,

    @{sysconfig}/etc/udev/hwdb.d/{,*}   r,

    /                                   r,
    /etc/udev/hwdb.d/{,*}               r,
    /usr/{bin,lib/systemd}/systemd-hwdb rm,

    owner /proc/@{pid}/stat             r,

    /etc/udev/.#hwdb.bin*               wl -> /etc/udev/#*,
    /{etc,usr/lib}/udev/#*              rwl,
    /usr/lib/udev/{,.#}hwdb.bin*        wl -> /usr/lib/udev/#*,
    /{etc,usr/lib}/udev/hwdb.bin        w,

    include if exists <local/usr.lib.systemd-hwdb>
}
