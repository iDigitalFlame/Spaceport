include <tunables/spaceport>

profile webkit /usr/lib/webkit2gtk-*/WebKit*Process flags=(enforce, attach_disconnected) {
    include <abstractions/qt>
    include <abstractions/gtk>
    include <abstractions/dconf>
    include <abstractions/video>
    include <abstractions/cgroup>
    include <abstractions/version>

    network                                                                        inet  stream,
    network                                                                        inet6 stream,

    /usr/share/glib-2.0/schemas/gschemas.compiled                                  r,

    /sys/firmware/acpi/pm_profile                                                  r,

    /proc/zoneinfo                                                                 r,

    owner /proc/@{pid}/{cmdline,smaps,stat,statm}                                  r,

    /dev/udmabuf                                                                   rw,

    owner @{run}/user/@{uid}/qtwayland-*                                           rwk,
    owner @{run}/user/@{uid}/*-wayland{,.lock}                                     rwk,

    owner @{HOME}/.local/share/TelegramDesktop/tdata/user_data/*/cache/**          rw,
    owner @{HOME}/.local/share/TelegramDesktop/tdata/user_data/*/cache/*.sqlite    rwk,
    owner @{HOME}/.local/share/TelegramDesktop/tdata/user_data/*/data/storage/salt rw,

    include if exists <local/usr.lib.webkit>
}
