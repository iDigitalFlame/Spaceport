include <tunables/spaceport>

profile pipewire-pulse /usr/bin/pipewire-pulse flags=(enforce, attach_disconnected) {
    include <abstractions/base>
    include <abstractions/audio>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                  sys_ptrace,

    ptrace read,

    /                                           r,
    /etc/machine-id                             r,
    /etc/pipewire/{,**}                         r,
    /usr/bin/pipewire-pulse                     rm,
    /etc/pipewire/client.conf                   r,
    /usr/share/pipewire/{,**}                   r,
    /etc/pipewire/client.conf.d/{,**}           r,
    /usr/share/pipewire/client{,-rt}.conf       r,

    /sys/devices/virtual/dmi/id/*_{name,vendor} r,

    owner @{run}/user/@{uid}/pulse/pid          rw,

    /usr/bin/pactl                              ix,

    deny network,

    include if exists <local/usr.bin.pipewire-pulse>
}
