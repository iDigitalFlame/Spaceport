include <tunables/spaceport>

profile kmod /usr/bin/{kmod,lsmod,depmod,insmod,rmmod,modinfo,modprobe} flags=(attach_disconnected, enforce) {
    include <abstractions/base>
    include <abstractions/consoles>
    include <abstractions/nameservice>
    include <abstractions/private-files>

    capability                                mknod,
    capability                                syslog,
    capability                                net_admin,
    capability                                sys_module,
    capability                                dac_override,
    capability                                dac_read_search,

    network                                   inet raw,

    signal receive set=(hup, int, kill, term, winch),

    @{sysconfig}/etc/modules-load.d/{,*}      r,
    @{sysconfig}/etc/modprobe.d/{,*.conf}     r,

    /usr/src/*/*.ko                           r,
    /etc/depmod.d/{,*.conf}                   r,
    /etc/modprobe.d/{,*.conf}                 r,
    /var/lib/dkms/**/module/*.ko              r,
    /usr/lib/modprobe.d/{,*.conf}             r,

    /sys/module/{,**}                         r,

    /proc/cmdline                             r,
    /proc/modules                             r,

    /tmp/**/*.ko{,.zst}                       r,

    /usr/lib/modules/*/*modules.*             rw,

    owner /var/tmp/*modules*/{,**}            rw,

    owner @{run}/tmpfiles.d/                  w,
    owner @{run}/tmpfiles.d/static-nodes.conf w,

    owner /tmp/mkinitcpio.*/{,**}             rw,

    /usr/bin/id                               ix,
    /usr/bin/sysctl                           Px -> sysctl,
    /usr/bin/basename                         ix,
    /usr/bin/{,ba,da}sh                       ix,
    /usr/bin/{tru,fals}e                      ix,
    /usr/bin/mod{info,probe}                  ixrm,
    /usr/bin/{dep,ins,k,ls,rm}mod             ixrm,

    include if exists <local/usr.bin.kmod>
}
