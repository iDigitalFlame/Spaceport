include <tunables/spaceport>

profile smd-daemon /{,opt/spaceport/}usr/lib/smd/libexec/smd-daemon flags=(default_allow) {
    include <abstractions/smd>
    include <abstractions/no-network>

    signal send set=(alrm, cont, int, kill, quit, stop, term),

    @{sysconfig}/usr/lib/smd/libexec/*                     Px,
    @{sysconfig}/usr/lib/smd/bin/powerctl                  Px -> powerctl,

    /usr/share/edk2/**/*.fd                                r,
    /usr/share/hwdata/usb.ids                              r,

    /sys/class/net/**                                      r,
    /sys/firmware/dmi/tables/DMI                           r,
    /sys/bus/usb/devices/*/idVendor                        r,
    /proc/acpi/button/lid/LID*/state                       r,
    /sys/class/power_supply/AC/online                      r,
    /sys/class/bluetooth/*/rfkill*/state                   r,
    /sys/class/graphics/fb*/device/drm/card*/card*/status  r,
    /sys/class/graphics/fb*/device/drm/card*/card*/enabled r,

    /proc/self/mounts                                      r,

    /sys/devices/system/cpu/**                             rw,
    /sys/class/rfkill/rfkill*/**                           rw,
    /sys/class/rtc/rtc*/wakealarm                          rw,
    /sys/devices/system/cpu/intel_pstate/**                rw,
    /sys/class/backlight/*_backlight/{,max_}brightness     rw,

    /proc/sys/vm/nr_hugepages                              rw,

    /dev/bus/usb/**                                        rw,

    owner /etc/smd/{,*}                                    r,

    owner /var/cache/smd{,/,/**}                           rwk,
    owner /var/run/log/smd-*.log                           rw,

    owner @{run}/smd{,/,/**}                               rwk,

    /usr/bin/*                                             Pix,
    /usr/local/bin/*                                       Pix,
    /usr/lib/smd/libexec/*                                 Pix,
    /usr/lib/smd/bin/powerctl                              Px -> powerctl,

    unix (bind, listen) type=stream addr="@{run}/smd/*.sock",

    unix (accept, connect, receive, send) type=stream addr="@{run}/smd/*.sock",

    include if exists <local/usr.lib.smd-daemon>
}
