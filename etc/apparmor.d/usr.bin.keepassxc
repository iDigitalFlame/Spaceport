include <tunables/spaceport>

profile keepassxc /usr/bin/keepassxc flags=(enforce) {
    include <abstractions/qt>
    include <abstractions/dconf>
    include <abstractions/gnome>
    include <abstractions/openssl>
    include <abstractions/p11-kit>
    include <abstractions/consoles>
    include <abstractions/user-home>
    include <abstractions/no-network>
    include <abstractions/dbus-strict>
    include <abstractions/nameservice>
    include <abstractions/dbus-session-strict>
    include <abstractions/dbus-accessibility-strict>

    /usr/bin/                                                  r,
    /usr/bin/keepassxc                                         rm,
    /usr/share/keepassxc/**                                    r,

    /dev/                                                      r,

    /sys/bus/                                                  r,
    /sys/class/                                                r,
    /sys/devices/pci*/*/**                                     r,
    /sys/devices/pci*/uevent                                   r,

    @{run}/udev/data/**                                        r,

    owner @{CACHE}/keepassxc/keepassxc.ini                     rkl,

    owner @{CONFIG}/keepassxc/keepassxc.ini                    rk,

    owner @{HOME}/.local/ssh/*                                 r,
    owner @{HOME}/.local/lib/keepassxc.ini                     rk,

    owner @{HOME_DATA}/keepassxc.{conf,ini}                    rk,

    /{dev,sys}/bus/usb/{,**}                                   rw,
    /{dev,sys}/bus/usb/devices/{,**}                           rw,

    owner @{HOME}/{#*,*.kdbx,*.kdbx.*}                         rwkl,
    owner @{HOME}/Documents/**/{#*,*.kdbx,*.kdbx.*}            rwkl,
    owner @{HOME}/.c{ache,onfig}/keepassxc/keepassxc.ini.lock  rwkl,
    owner @{HOME}/@{XDG_DOCUMENTS_DIR}/**/{#*,*.kdbx,*.kdbx.*} rwkl,

    owner @{MOUNTS}/**/*{*.kdbx,*.kdbx.*}                      rwkl,

    /usr/bin/wl-copy                                           ix,
    /usr/bin/xdg-open                                          Px -> xdg-open,

    deny @{CONFIG}/keepassxc/keepassxc.{conf,ini}              w,

    deny @{HOME}/.local/lib/keepassxc.{conf,ini}               w,
    deny @{HOME}/.c{ache,onfig}/keepassxc/keepassxc.{conf,ini} w,

    deny @{HOME_DATA}/keepassxc.{conf,ini}                     w,

    include if exists <local/usr.bin.keepassxc>
}
