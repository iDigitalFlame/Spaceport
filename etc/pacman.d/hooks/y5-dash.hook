[Trigger]
Type        = Package
Target      = bash
Target      = dash
Operation   = Install
Operation   = Upgrade

[Action]
Exec        = /usr/bin/dash -c "rm -f '/usr/bin/sh'; ln -sfT '/usr/bin/dash' '/usr/bin/sh'"
When        = PostTransaction
Depends     = dash
Description = Re-pointing "/bin/sh" symlink to dash..
