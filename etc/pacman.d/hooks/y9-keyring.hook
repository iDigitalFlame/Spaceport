[Trigger]
Type        = Package
Target      = gnome-keyring
Operation   = Install
Operation   = Upgrade

[Action]
Exec        = /usr/bin/setcap cap_ipc_lock=+ep "/usr/bin/gnome-keyring-daemon"
When        = PostTransaction
Description = Updating capabilities on gnome-keyring-daemon..
