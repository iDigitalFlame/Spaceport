[Trigger]
Type        = Path
Target      = usr/lib/sysusers.d/*.conf
Operation   = Remove
Operation   = Install
Operation   = Upgrade

[Action]
Exec        = /usr/bin/python3 -X pycache_prefix=/var/cache/python -OO /usr/lib/smd/sbin/sysusers-audit
When        = PostTransaction
Description = Checking sysusers configuration..
